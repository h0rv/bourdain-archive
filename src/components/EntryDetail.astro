---
import linkPreviewCache from '../../archive/derived/link-previews.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  archiveTargetsForUrl,
  availabilityBadges,
  bourdainRelationLabel,
  entryHref,
  entryTitle,
  formatDate,
  formatType,
  hostnameForUrl,
  humanizeIdentifier,
  kindFor,
  previewForEntry,
  statusClass,
  visibleStatus,
} from '../lib/content';

interface Props {
  entry: any;
  collection: string;
  sources?: any[];
  relatedEntries?: any[];
  childEntries?: any[];
  imageAttribution?: {
    artist?: string;
    license?: string;
    source_title?: string;
    source_url?: string;
  };
}

const {
  entry,
  collection,
  sources = [],
  relatedEntries = [],
  childEntries = [],
  imageAttribution,
} = Astro.props;
const data = entry.data;
const title = entryTitle(entry);
const relationLabel = bourdainRelationLabel(data.relation_to_bourdain, collection);
const displayStatus = visibleStatus(data.status);
const noindex = data.status !== 'confirmed' && data.status !== 'partial';

const sourceById = new Map(sources.map((source: any) => [source.data.id, source]));
const referencedSources = (data.sources ?? [])
  .map((id: string) => sourceById.get(id))
  .filter(Boolean);

const primaryPreview = previewForEntry(entry, linkPreviewCache.previews);
const sourceArtwork = referencedSources
  .map((source: any) => ({ source, preview: previewForEntry(source, linkPreviewCache.previews) }))
  .find((item: any) => item.preview.image);
const heroImage = primaryPreview.image ?? sourceArtwork?.preview.image;
const heroArtworkSource = primaryPreview.image ? undefined : sourceArtwork;
const portraitArtwork = [
  'adaptation',
  'acted-role',
  'book',
  'comic',
  'documentary',
  'film',
  'show',
  'television',
  'voice-role',
].includes(data.type);

const availabilityActions = availabilityBadges(data.availability)
  .filter((item) => item.url)
  .map((item) => ({ ...item, host: hostnameForUrl(item.url) }));

const relatedById = new Map(
  relatedEntries.map((item: any) => [item.entry.data.id, item]),
);
const relatedRefs = (data.related ?? [])
  .map((id: string) => relatedById.get(id))
  .filter(Boolean);

const entityFor = (id: string) => {
  const resolved: any = relatedById.get(id);
  return resolved
    ? {
        href: entryHref(resolved.collection, resolved.entry.data.id),
        label: entryTitle(resolved.entry),
      }
    : { label: humanizeIdentifier(id) };
};

const contributors = (data.contributors ?? []).map(entityFor);
const roleCredits = (data.roles ?? []).map((credit: any) => {
  const person = entityFor(credit.person);
  const creditedAs = credit.credited_as ? ` as ${credit.credited_as}` : '';
  return { ...person, detail: `${credit.role}${creditedAs}` };
});
const sortedChildEntries = [...childEntries].sort(
  (left: any, right: any) =>
    (left.entry.data.season ?? 0) - (right.entry.data.season ?? 0) ||
    (left.entry.data.episode ?? 0) - (right.entry.data.episode ?? 0) ||
    entryTitle(left.entry).localeCompare(entryTitle(right.entry)),
);
const episodeGroups = new Map<number, any[]>();
for (const item of sortedChildEntries) {
  const season = item.entry.data.season ?? 0;
  const group = episodeGroups.get(season) ?? [];
  group.push(item);
  episodeGroups.set(season, group);
}
const groupedEpisodes = [...episodeGroups.entries()].sort(([left], [right]) => left - right);

const episodeCode =
  data.season != null && data.episode != null
    ? `S${String(data.season).padStart(2, '0')}E${String(data.episode).padStart(2, '0')}`
    : undefined;
const hasRecordDetails =
  Boolean(data.publication) ||
  Boolean(data.host) ||
  Boolean(data.role) ||
  Boolean(data.duration_minutes) ||
  contributors.length > 0 ||
  roleCredits.length > 0;
---
<BaseLayout title={title} description={data.summary ?? title} image={heroImage} noindex={noindex}>
  <article class="entry-detail">
    <header
      class:list={[
        'entry-hero',
        portraitArtwork ? 'is-portrait' : 'is-landscape',
        !heroImage && 'without-art',
      ]}
    >
      {heroImage && (
        <figure class="entry-artwork">
          <img
            src={heroImage}
            alt=""
            width={portraitArtwork ? 720 : 1280}
            height={portraitArtwork ? 1080 : 720}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          {imageAttribution ? (
            <figcaption>
              {imageAttribution.artist && <span>{imageAttribution.artist}</span>}
              {imageAttribution.license && <span>, {imageAttribution.license}</span>}
              {imageAttribution.source_url && (
                <span>
                  {', '}
                  <a href={imageAttribution.source_url} target="_blank" rel="noreferrer">
                    {imageAttribution.source_title ?? 'Image source'}
                  </a>
                </span>
              )}
            </figcaption>
          ) : heroArtworkSource && (
            <figcaption>
              Preview via {hostnameForUrl(heroArtworkSource.source.data.url) ?? 'cited source'}
            </figcaption>
          )}
        </figure>
      )}

      <div class="entry-hero-copy">
        <p class="entry-taxonomy">{relationLabel}</p>
        <h1 class="page-title entry-title">{title}</h1>
        <p class="entry-byline">
          <span>{formatType(kindFor(data, collection))}</span>
          {episodeCode && <span>{episodeCode}</span>}
          {data.date && <time datetime={data.date}>{formatDate(data.date, data.date_precision)}</time>}
          {displayStatus && (
            <span class={`entry-status ${statusClass(displayStatus)}`}>
              {formatType(displayStatus)}
            </span>
          )}
        </p>

        {data.summary && <p class="entry-deck">{data.summary}</p>}

        {availabilityActions.length > 0 && (
          <nav class="availability-actions" aria-label="Availability">
            {availabilityActions.map((action) => (
              <a href={action.url} target="_blank" rel="noreferrer">
                <span>{action.label}</span>
                {action.host && <small>{action.host}</small>}
              </a>
            ))}
          </nav>
        )}
      </div>
    </header>

    {hasRecordDetails && (
      <section class="detail-box record-details" aria-labelledby="record-details-heading">
        <h2 id="record-details-heading">Details</h2>
        <dl class="fact-list">
          {data.publication && <><dt>Publication</dt><dd>{data.publication}</dd></>}
          {data.host && <><dt>Host</dt><dd>{data.host}</dd></>}
          {data.role && <><dt>Role</dt><dd>{data.role}</dd></>}
          {data.duration_minutes && <><dt>Duration</dt><dd>{data.duration_minutes} minutes</dd></>}
          {contributors.length > 0 && (
            <>
              <dt>{contributors.length === 1 ? 'Contributor' : 'Contributors'}</dt>
              <dd class="entity-line">
                {contributors.map((contributor: any, index: number) => (
                  <>{index > 0 && ', '}{contributor.href ? <a href={contributor.href}>{contributor.label}</a> : contributor.label}</>
                ))}
              </dd>
            </>
          )}
          {roleCredits.length > 0 && (
            <>
              <dt>Credits</dt>
              <dd class="credit-list">
                {roleCredits.map((credit: any) => (
                  <span>{credit.href ? <a href={credit.href}>{credit.label}</a> : credit.label}, {credit.detail}</span>
                ))}
              </dd>
            </>
          )}
        </dl>
      </section>
    )}

    {referencedSources.length > 0 && (
      <section class="detail-box sources-box" aria-labelledby="sources-heading">
        <h2 id="sources-heading">Sources</h2>
        <ol class="citation-list">
          {referencedSources.map((source: any) => {
            const sourceData = source.data;
            const host = hostnameForUrl(sourceData.url);
            const archive = host === 'web.archive.org' ? undefined : archiveTargetsForUrl(sourceData.url);
            return (
              <li>
                <div>
                  <a class="citation-title" href={sourceData.url} target="_blank" rel="noreferrer">
                    {entryTitle(source)}
                  </a>
                  <p class="citation-meta">
                    {host && <span>{host}</span>}
                    {sourceData.date && <time datetime={sourceData.date}>{formatDate(sourceData.date, sourceData.date_precision)}</time>}
                  </p>
                  {archive && (
                    <p class="citation-actions">
                      <a href={archive.latest_url} target="_blank" rel="noreferrer">Saved copy</a>
                    </p>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    )}

    {groupedEpisodes.length > 0 && (
      <section class="detail-box episodes-box" aria-labelledby="episodes-heading">
        <div class="section-title-row">
          <h2 id="episodes-heading">Episodes</h2>
          <span>{sortedChildEntries.length} total</span>
        </div>
        <div class="episode-seasons">
          {groupedEpisodes.map(([season, items], index) => (
            <details class="episode-season" open={index === 0}>
              <summary>
                <span>{season > 0 ? `Season ${String(season).padStart(2, '0')}` : 'Episodes'}</span>
                <small>{items.length}</small>
              </summary>
              <ol class="episode-records">
                {items.map((item: any) => {
                  const child = item.entry.data;
                  const code =
                    child.season != null && child.episode != null
                      ? `S${String(child.season).padStart(2, '0')}E${String(child.episode).padStart(2, '0')}`
                      : undefined;
                  return (
                    <li>
                      {code && <span class="episode-code">{code}</span>}
                      <a href={entryHref(item.collection, child.id)}>{entryTitle(item.entry)}</a>
                      <span class="episode-record-meta">
                        {child.date && <time datetime={child.date}>{formatDate(child.date, child.date_precision)}</time>}
                        {child.places?.length > 0 && <span>{child.places.map((place: string) => entityFor(place).label).join(', ')}</span>}
                      </span>
                    </li>
                  );
                })}
              </ol>
            </details>
          ))}
        </div>
      </section>
    )}

    {relatedRefs.length > 0 && (
      <section class="detail-box related-box" aria-labelledby="related-heading">
        <h2 id="related-heading">Related</h2>
        <ul class="related-records">
          {relatedRefs.map((item: any) => (
            <li>
              <a href={entryHref(item.collection, item.entry.data.id)}>{entryTitle(item.entry)}</a>
              <span>{formatType(kindFor(item.entry.data, item.collection))}{item.entry.data.date ? `, ${formatDate(item.entry.data.date, item.entry.data.date_precision)}` : ''}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
