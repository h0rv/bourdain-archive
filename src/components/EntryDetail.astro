---
import linkPreviewCache from '../../archive/derived/link-previews.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import { availabilityBadges, entryHref, entryTitle, formatDate, formatType, kindFor, previewForUrl, statusClass, visibleStatus } from '../lib/content';

interface Props {
  entry: any;
  collection: string;
  sources?: any[];
  relatedEntries: any[];
  childEntries?: any[];
}

const { entry, collection, relatedEntries, childEntries = [] } = Astro.props;
const data = entry.data;
const title = entryTitle(entry);
const relatedRefs = (data.related ?? []).map((id: string) => relatedEntries.find((item: any) => item.entry.data.id === id)).filter(Boolean);
const sortedChildEntries = [...childEntries].sort((left: any, right: any) =>
  (left.entry.data.season ?? 0) - (right.entry.data.season ?? 0) ||
  (left.entry.data.episode ?? 0) - (right.entry.data.episode ?? 0) ||
  entryTitle(left.entry).localeCompare(entryTitle(right.entry))
);
const badges = availabilityBadges(data.availability);
const availabilityPreviews = badges.map((badge) => ({ ...badge, preview: previewForUrl(badge.url, linkPreviewCache.previews) }));
const displayStatus = visibleStatus(data.status);
---
<BaseLayout title={title} description={data.summary ?? title}>
  <article>
    <h1 class="page-title">{title}</h1>
    <p class="meta">
      {formatType(kindFor(data, collection))}
      {data.season && data.episode ? ` · S${String(data.season).padStart(2, '0')}E${String(data.episode).padStart(2, '0')}` : ''}
      {data.date ? ` · ${formatDate(data.date, data.date_precision)}` : ''}
      {displayStatus && <> · <span class={`badge ${statusClass(displayStatus)}`}>{displayStatus}</span></>}
    </p>

    {data.summary && <p class="lede">{data.summary}</p>}

    <div class="detail-grid">
      <section class="detail-box availability-box">
        <h2>Availability</h2>
        <div class="link-preview-list">
          {availabilityPreviews.map((badge) => (
            badge.url ? (
              <div class="link-preview">
                <span class="link-preview-media">
                  {badge.preview.image ? (
                    <img src={badge.preview.image} alt="" loading="lazy" />
                  ) : badge.preview.favicon ? (
                    <img class="link-preview-favicon" src={badge.preview.favicon} alt="" loading="lazy" />
                  ) : (
                    <span>{badge.label}</span>
                  )}
                </span>
                <span class="link-preview-copy">
                  <strong>{badge.label}</strong>
                  {badge.preview.host && <span>{badge.preview.host}</span>}
                  <code>{badge.url}</code>
                  <span class="link-preview-actions">
                    <a href={badge.url}>Open</a>
                    {badge.preview.archive && <a href={badge.preview.archive.latest_url}>Archive</a>}
                  </span>
                </span>
              </div>
            ) : (
              <p class="meta">{badge.label}</p>
            )
          ))}
        </div>
      </section>

      {data.tags?.length > 0 && (
        <section class="detail-box">
          <h2>Tags</h2>
          <ul class="tag-list">
            {data.tags.map((tag: string) => <li class="tag">{tag}</li>)}
          </ul>
        </section>
      )}

      {data.people?.length > 0 && (
        <section class="detail-box">
          <h2>People</h2>
          <ul class="clean-list">
            {data.people.map((person: string) => <li>{person}</li>)}
          </ul>
        </section>
      )}

      {data.places?.length > 0 && (
        <section class="detail-box">
          <h2>Places</h2>
          <ul class="clean-list">
            {data.places.map((place: string) => <li>{place}</li>)}
          </ul>
        </section>
      )}
    </div>

    {sortedChildEntries.length > 0 && (
      <section class="detail-box">
        <h2>Episodes</h2>
        <ul class="clean-list">
          {sortedChildEntries.map((item: any) => (
            <li>
              <a href={entryHref(item.collection, item.entry.data.id)}>{entryTitle(item.entry)}</a>
              <span class="meta">
                {item.entry.data.season && item.entry.data.episode ? ` S${String(item.entry.data.season).padStart(2, '0')}E${String(item.entry.data.episode).padStart(2, '0')}` : ''}
                {item.entry.data.date ? ` · ${formatDate(item.entry.data.date, item.entry.data.date_precision)}` : ''}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="detail-box">
      <h2>Related</h2>
      {relatedRefs.length > 0 ? (
        <ul class="clean-list">
          {relatedRefs.map((item: any) => (
            <li><a href={entryHref(item.collection, item.entry.data.id)}>{entryTitle(item.entry)}</a></li>
          ))}
        </ul>
      ) : (
        <p class="meta">None.</p>
      )}
    </section>
  </article>
</BaseLayout>
