---
import { getCollection } from 'astro:content';
import linkPreviewCache from '../../../archive/derived/link-previews.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  entryHref,
  entryTitle,
  formatDate,
  formatType,
  previewForEntry,
  primaryAvailabilityUrl,
} from '../../lib/content';
import '../../styles/catalog.css';

const screen = (await getCollection('screen')).map((entry) => ({ entry, collection: 'screen' }));
const appearances = (await getCollection('appearances')).map((entry) => ({
  entry,
  collection: 'appearances',
}));

type MediaShape = 'portrait' | 'landscape' | 'square';

const shapeFromImageUrl = (image?: string): MediaShape | undefined => {
  if (!image) return undefined;
  let normalized = image.toLocaleLowerCase();
  try {
    normalized = decodeURIComponent(normalized);
  } catch {
    // Keep the original URL when it contains an incomplete escape sequence.
  }

  const dimensions = [...normalized.matchAll(/(\d{3,4})x(\d{3,4})/g)].at(-1);
  if (dimensions) {
    const ratio = Number(dimensions[1]) / Number(dimensions[2]);
    if (ratio >= 1.25) return 'landscape';
    if (ratio <= 0.8) return 'portrait';
    return 'square';
  }

  if (/(?:ytimg|youtube|horizontal|_wide\b|maxresdefault|sddefault|hqdefault)/.test(normalized)) {
    return 'landscape';
  }
  return undefined;
};

const mediaShapeFor = (data: any, image?: string): MediaShape => {
  const imageShape = shapeFromImageUrl(image);
  if (imageShape) return imageShape;
  if (['documentary', 'film', 'adaptation', 'television'].includes(data.type)) return 'portrait';
  if (['podcast', 'radio'].includes(data.type)) return 'square';
  return 'landscape';
};

const items = [...screen, ...appearances]
  .map((item) => {
    const data: any = item.entry.data;
    const title = entryTitle(item.entry);
    const preview = previewForEntry(item.entry, linkPreviewCache.previews);
    const externalUrl = primaryAvailabilityUrl(data);
    const shape = mediaShapeFor(data, preview.image);
    const dimensions = {
      portrait: { width: 400, height: 600 },
      landscape: { width: 640, height: 400 },
      square: { width: 500, height: 500 },
    }[shape];
    const group =
      item.collection === 'appearances'
        ? 'interviews'
        : data.relation_to_bourdain === 'about'
          ? 'about'
          : 'roles';
    return {
      ...item,
      data,
      title,
      preview,
      externalUrl,
      shape,
      dimensions,
      group,
      searchable: [title, data.summary, data.type, data.role, data.host, ...(data.tags ?? [])]
        .filter(Boolean)
        .join(' ')
        .toLocaleLowerCase(),
    };
  })
  .sort(
    (left, right) =>
      (right.data.date ?? '').localeCompare(left.data.date ?? '') ||
      left.title.localeCompare(right.title),
  );

const typeOptions = [...new Set(items.map((item) => item.data.type))].sort();
const groups = [
  {
    id: 'roles',
    title: 'On screen',
    description: 'Acting, voice roles, cameos, and documentary appearances.',
  },
  {
    id: 'about',
    title: 'Films and adaptations about Bourdain',
    description: 'Documentaries, films, and adaptations centered on his life or work.',
  },
  {
    id: 'interviews',
    title: 'Interviews and podcasts',
    description: 'Interviews, podcasts, radio, panels, and talks.',
  },
];
---

<BaseLayout
  title="Films and appearances"
  description="Anthony Bourdain's film roles, cameos, documentaries, interviews, podcasts, and talks."
>
  <div class="catalog-page" data-screen-catalog>
    <header class="catalog-intro">
      <h1 class="page-title">Films and appearances</h1>
      <p>
        Cameos, documentaries, interviews, podcasts, and talks. See
        <a href="../tv/">Television</a> for the series he hosted.
      </p>
    </header>

    <form class="catalog-tools screen-catalog-tools" role="search">
      <label class="catalog-field">
        <span>Search</span>
        <input type="search" placeholder="Title, role, host, or subject" autocomplete="off" data-screen-search />
      </label>
      <label class="catalog-field">
        <span>Category</span>
        <select data-screen-group-filter>
          <option value="">All categories</option>
          {groups.map((group) => <option value={group.id}>{group.title}</option>)}
        </select>
      </label>
      <label class="catalog-field">
        <span>Type</span>
        <select data-screen-type>
          <option value="">All types</option>
          {typeOptions.map((type) => <option value={type}>{formatType(type)}</option>)}
        </select>
      </label>
    </form>

    <div class="screen-groups">
      {groups.map((group, groupIndex) => (
        <section class="screen-group" data-screen-group={group.id} aria-labelledby={`screen-${group.id}`}>
          <header>
            <h2 id={`screen-${group.id}`}>{group.title}</h2>
            <p>{group.description}</p>
          </header>
          <ol class="catalog-grid">
            {items.filter((item) => item.group === group.id).map((item, index) => (
              <li
                class:list={['catalog-tile', item.preview.image && 'has-media']}
                data-screen-item
                data-group={item.group}
                data-type={item.data.type}
                data-search={item.searchable}
              >
                {item.preview.image && (
                  <a
                    class:list={['catalog-tile-media', `is-${item.shape}`]}
                    href={entryHref(item.collection, item.data.id)}
                    tabindex="-1"
                  >
                    <img
                      src={item.preview.image}
                      alt=""
                      loading={groupIndex === 0 && index < 5 ? 'eager' : 'lazy'}
                      fetchpriority={groupIndex === 0 && index < 2 ? 'high' : undefined}
                      decoding="async"
                      width={item.dimensions.width}
                      height={item.dimensions.height}
                    />
                  </a>
                )}
                <a class="catalog-tile-title" href={entryHref(item.collection, item.data.id)}>{item.title}</a>
                <span class="catalog-row-meta">
                  {formatDate(item.data.date, item.data.date_precision)}, {formatType(item.data.type)}
                  {item.data.role ? `, ${item.data.role}` : ''}
                </span>
                <div class="catalog-tile-actions">
                  <a href={entryHref(item.collection, item.data.id)}>Open</a>
                  {item.externalUrl && (
                    <a href={item.externalUrl} target="_blank" rel="noopener noreferrer">Source</a>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
    <p class="catalog-empty" data-screen-empty hidden>No matches.</p>
  </div>

  <script>
    const root = document.querySelector<HTMLElement>('[data-screen-catalog]');
    const search = root?.querySelector<HTMLInputElement>('[data-screen-search]');
    const groupFilter = root?.querySelector<HTMLSelectElement>('[data-screen-group-filter]');
    const type = root?.querySelector<HTMLSelectElement>('[data-screen-type]');
    const items = [...(root?.querySelectorAll<HTMLElement>('[data-screen-item]') ?? [])];
    const groups = [...(root?.querySelectorAll<HTMLElement>('[data-screen-group]') ?? [])];
    const empty = root?.querySelector<HTMLElement>('[data-screen-empty]');

    const apply = () => {
      const query = search?.value.trim().toLocaleLowerCase() ?? '';
      let visible = 0;
      for (const item of items) {
        const matches =
          (!query || item.dataset.search?.includes(query)) &&
          (!groupFilter?.value || item.dataset.group === groupFilter.value) &&
          (!type?.value || item.dataset.type === type.value);
        item.hidden = !matches;
        if (matches) visible += 1;
      }

      for (const group of groups) {
        group.hidden = ![...group.querySelectorAll<HTMLElement>('[data-screen-item]')].some((item) => !item.hidden);
      }
      if (empty) empty.hidden = visible !== 0;
    };

    root?.querySelector('form')?.addEventListener('input', apply);
    root?.querySelector('form')?.addEventListener('change', apply);
    root?.querySelector('form')?.addEventListener('submit', (event) => event.preventDefault());
  </script>
</BaseLayout>
