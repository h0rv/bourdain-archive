---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/site';
---

<BaseLayout title="Not found" description="The page could not be found." noindex>
  <section class="not-found">
    <p class="eyebrow">404</p>
    <h1 class="page-title">Page not found</h1>
    <p class="lede">The page may have moved, or the address may be wrong.</p>
    <p class="home-actions">
      <a class="primary-action" href={withBase('/archive/')}>Search the archive</a>
      <a href={withBase('/')}>Return home</a>
    </p>
  </section>
</BaseLayout>
