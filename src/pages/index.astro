---
import { getCollection } from 'astro:content';
import linkPreviewCache from '../../archive/derived/link-previews.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import { entryHref, entryTitle, formatDate, formatType, previewForEntry, archiveTargetsForUrl, primaryAvailabilityUrl } from '../lib/content';
import { withBase } from '../lib/site';

const works = await getCollection('works');
const series = await getCollection('series');
const screen = await getCollection('screen');
const appearances = await getCollection('appearances');
const literature = await getCollection('literature');
const places = await getCollection('places');
const events = await getCollection('events');
const sources = await getCollection('sources');

const sourceById = new Map(sources.map((e) => [e.data.id, e]));

const shows = series.filter((s) => s.data.type === 'show').sort((a,b) => (a.data.date ?? '').localeCompare(b.data.date ?? ''));
const writingsPreview = works.filter((w) => w.data.relation_to_bourdain === 'authored').sort((a,b) => (a.data.date ?? '').localeCompare(b.data.date ?? '')).slice(0,6);

const previewFor = (entry: any) => {
  const own = previewForEntry(entry, linkPreviewCache.previews);
  if (own.image) return own;
  for (const sid of entry.data.sources ?? []) {
    const src = sourceById.get(sid);
    if (!src) continue;
    const pv = previewForEntry(src, linkPreviewCache.previews);
    if (pv.image) return { ...own, image: pv.image, host: pv.host, url: pv.url, archive: pv.archive };
  }
  return own;
};
const imgFor = (entry: any) => previewFor(entry).image ?? '';
const officialFor = (entry: any) => previewFor(entry).url ?? primaryAvailabilityUrl(entry.data);
const archiveFor = (entry: any) => previewFor(entry).archive ?? archiveTargetsForUrl(officialFor(entry));

const topPlaces = [...places].slice(0, 36);


---
<BaseLayout title="Bourdain Archive">
  <section class="archive-index" aria-label="Bourdain Archive index">
    <h1 class="sr-only">Anthony Bourdain Archive</h1>



        <section id="writings" aria-labelledby="writings-heading">
          <h2 id="writings-heading" class="section-heading">Writings</h2>
          <ol class="shelf-grid">
            {writingsPreview.map((entry, idx) => {
              const isWork = works.some(w=>w.data.id===entry.data.id);
              const href = isWork ? entryHref('works', entry.data.id) : entryHref('literature', entry.data.id);
              const img = imgFor(entry);
              const title = entryTitle(entry);
              return (
                <li class="shelf-card">
                  <a href={href}>
                    <span class="shelf-card-media"><img src={img || withBase('/images/placeholder.svg')} alt={img ? `${title} cover` : ""} loading={idx === 0 ? "eager" : "lazy"} fetchpriority={idx === 0 ? "high" : undefined} decoding="async" width="400" height="500" /></span>
                    <span class="shelf-card-title">{entryTitle(entry)}</span>
                    <span class="shelf-card-meta">{formatDate(entry.data.date, entry.data.date_precision)} · {formatType(entry.data.type)}</span>
                  </a>
                </li>
              );
            })}
          </ol>
          <p class="meta"><a href={withBase('/writings/')}>All writings →</a></p>
        </section>

        <section id="tv" aria-labelledby="tv-heading">
          <h2 id="tv-heading" class="section-heading">TV Shows</h2>
          <ol class="shelf-grid">
            {shows.slice(0,6).map((show) => {
              const img = imgFor(show);
              const title = entryTitle(show);
              return (
                <li class="shelf-card">
                  <a href={entryHref('series', show.data.id)}>
                    <span class="shelf-card-media"><img src={img || withBase('/images/placeholder.svg')} alt={img ? `${title} cover` : ""} loading="lazy" decoding="async" width="400" height="500" /></span>
                    <span class="shelf-card-title">{title}</span>
                  </a>
                </li>
              );
            })}
          </ol>
          <p class="meta"><a href={withBase('/tv/')}>All shows →</a></p>
        </section>

        <section id="screen" aria-labelledby="screen-heading">
          <h2 id="screen-heading" class="section-heading">Films &amp; Appearances</h2>
          <ol class="shelf-grid">
            {[...appearances, ...screen].sort((a,b) => (b.data.date ?? '').localeCompare(a.data.date ?? '')).slice(0,6).map((entry) => {
              const col = screen.some((s)=> s.data.id === entry.data.id) ? 'screen' : 'appearances';
              const img = imgFor(entry);
              const title = entryTitle(entry);
              return (
                <li class="shelf-card">
                  <a href={entryHref(col, entry.data.id)}>
                    <span class="shelf-card-media"><img src={img || withBase('/images/placeholder.svg')} alt={img ? `${title} cover` : ""} loading="lazy" decoding="async" width="400" height="500" /></span>
                    <span class="shelf-card-title">{title}</span>
                    <span class="shelf-card-meta">{formatType(entry.data.type)}</span>
                  </a>
                </li>
              );
            })}
          </ol>
          <p class="meta"><a href={withBase('/tv/')}>More →</a></p>
        </section>

        <section id="map" aria-labelledby="map-heading">
          <h2 id="map-heading" class="section-heading">Places</h2>
          <ol class="places-list">
            {topPlaces.slice(0,6).map((place) => (
              <li>
                <a href={entryHref('places', place.data.id)}>{place.data.name ?? place.data.id}</a>
              </li>
            ))}
          </ol>
          <p class="meta"><a href={withBase('/map/')}>Open interactive map →</a></p>
        </section>
  </section>
</BaseLayout>
