---
import { getCollection } from 'astro:content';
import linkPreviewCache from '../../archive/derived/link-previews.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  entryHref,
  entryTitle,
  formatDate,
  formatType,
  previewForEntry,
} from '../lib/content';
import { withBase } from '../lib/site';

const works = await getCollection('works');
const series = await getCollection('series');
const screen = await getCollection('screen');
const appearances = await getCollection('appearances');
const literature = await getCollection('literature');
const places = await getCollection('places');
const sources = await getCollection('sources');

const sourceById = new Map(sources.map((entry) => [entry.data.id, entry]));
const shows = series
  .filter((entry) => entry.data.type === 'show')
  .sort((left, right) => (left.data.date ?? '').localeCompare(right.data.date ?? ''));
const episodes = series.filter((entry) => entry.data.type === 'episode');

const selectedWorkIds = [
  'kitchen-confidential',
  'a-cooks-tour-book',
  'medium-raw',
  'appetites',
  'world-travel',
  'anthony-bourdain-reader',
];
const selectedWorks = selectedWorkIds
  .map((id) => works.find((entry) => entry.data.id === id))
  .filter(Boolean);

const latestContext = [
  ...screen
    .filter((entry) => entry.data.relation_to_bourdain === 'about')
    .map((entry) => ({ entry, collection: 'screen' })),
  ...literature
    .filter((entry) => entry.data.relation_to_bourdain === 'about')
    .map((entry) => ({ entry, collection: 'literature' })),
]
  .sort((left, right) => (right.entry.data.date ?? '').localeCompare(left.entry.data.date ?? ''))
  .slice(0, 6);

const featuredPlaceIds = [
  'new-york-city',
  'new-jersey',
  'queens',
  'tokyo',
  'vietnam',
  'hong-kong',
  'beirut',
  'paris',
  'detroit',
  'les-halles',
];
const featuredPlaces = featuredPlaceIds
  .map((id) => places.find((entry) => entry.data.id === id))
  .filter(Boolean);

const previewFor = (entry: any) => {
  const own = previewForEntry(entry, linkPreviewCache.previews);
  if (own.image) return own;
  for (const sourceId of entry.data.sources ?? []) {
    const source = sourceById.get(sourceId);
    if (!source) continue;
    const sourcePreview = previewForEntry(source, linkPreviewCache.previews);
    if (sourcePreview.image) return { ...own, image: sourcePreview.image };
  }
  return own;
};

const stats = [
  { value: works.length, label: 'books + written works', href: withBase('/writings/') },
  { value: episodes.length, label: 'television episodes', href: withBase('/tv/') },
  {
    value: screen.length + appearances.length,
    label: 'screen + audio records',
    href: withBase('/screen/'),
  },
  { value: literature.length, label: 'selected critical works', href: withBase('/writings/#about') },
  { value: places.length, label: 'places indexed', href: withBase('/places/') },
  { value: sources.length, label: 'sources preserved', href: withBase('/sources/') },
];
---

<BaseLayout title="Bourdain Archive">
  <section class="home-intro" aria-labelledby="home-title">
    <p class="eyebrow">1956–2018 · work, travels, afterlives</p>
    <h1 id="home-title">Anthony Bourdain, indexed.</h1>
    <p class="home-deck">
      A sourced guide to the books, essays, television, films, interviews, places, and serious
      writing that make up Bourdain’s cultural record. No mirrors. No celebrity filler. Just the
      work and the trail it left behind.
    </p>
    <p class="home-actions">
      <a class="primary-action" href={withBase('/archive/')}>Search the complete archive</a>
      <a href={withBase('/about/')}>Read the methodology</a>
    </p>
  </section>

  <dl class="archive-stats" aria-label="Archive contents">
    {stats.map((stat) => (
      <div>
        <dt><a href={stat.href}>{stat.label}</a></dt>
        <dd>{stat.value.toLocaleString('en-US')}</dd>
      </div>
    ))}
  </dl>

  <section class="home-section" aria-labelledby="books-heading">
    <header class="section-header">
      <div>
        <p class="eyebrow">By Bourdain</p>
        <h2 id="books-heading">The books</h2>
      </div>
      <a href={withBase('/writings/')}>All writing →</a>
    </header>
    <ol class="shelf-grid shelf-grid-books">
      {selectedWorks.map((entry: any, index) => {
        const preview = previewFor(entry);
        const title = entryTitle(entry);
        return (
          <li class="shelf-card">
            <a href={entryHref('works', entry.data.id)}>
              <span class="shelf-card-media is-portrait">
                {preview.image ? (
                  <img
                    src={preview.image}
                    alt=""
                    loading={index < 2 ? 'eager' : 'lazy'}
                    fetchpriority={index === 0 ? 'high' : undefined}
                    decoding="async"
                    width="400"
                    height="600"
                  />
                ) : (
                  <span class="shelf-card-fallback">{formatType(entry.data.type)}</span>
                )}
              </span>
              <span class="shelf-card-title">{title}</span>
              <span class="shelf-card-meta">
                {formatDate(entry.data.date, entry.data.date_precision)} · {formatType(entry.data.type)}
              </span>
            </a>
          </li>
        );
      })}
    </ol>
  </section>

  <section class="home-section" aria-labelledby="television-heading">
    <header class="section-header">
      <div>
        <p class="eyebrow">Featuring Bourdain</p>
        <h2 id="television-heading">Television</h2>
      </div>
      <a href={withBase('/tv/')}>{episodes.length} episodes →</a>
    </header>
    <ol class="shelf-grid shelf-grid-shows">
      {shows.map((show) => {
        const preview = previewFor(show);
        const count = episodes.filter((episode) => episode.data.parent_id === show.data.id).length;
        return (
          <li class="shelf-card">
            <a href={entryHref('series', show.data.id)}>
              <span class="shelf-card-media is-portrait">
                {preview.image ? (
                  <img src={preview.image} alt="" loading="lazy" decoding="async" width="400" height="600" />
                ) : (
                  <span class="shelf-card-fallback">Television</span>
                )}
              </span>
              <span class="shelf-card-title">{entryTitle(show)}</span>
              <span class="shelf-card-meta">
                {formatDate(show.data.date, show.data.date_precision)}{count ? ` · ${count} episodes` : ''}
              </span>
            </a>
          </li>
        );
      })}
    </ol>
  </section>

  <section class="home-section" aria-labelledby="context-heading">
    <header class="section-header">
      <div>
        <p class="eyebrow">About Bourdain</p>
        <h2 id="context-heading">Recent + essential context</h2>
      </div>
      <a href={withBase('/writings/#about')}>Selected criticism →</a>
    </header>
    <ol class="editorial-list">
      {latestContext.map(({ entry, collection }) => {
        const preview = previewFor(entry);
        return (
          <li>
            <a class="editorial-list-media" href={entryHref(collection, entry.data.id)}>
              {preview.image ? (
                <img src={preview.image} alt="" loading="lazy" decoding="async" width="320" height="200" />
              ) : (
                <span>{(entry.data as any).publication ?? formatType(entry.data.type)}</span>
              )}
            </a>
            <div>
              <p class="eyebrow">
                {(entry.data as any).publication ?? formatType(entry.data.type)} · {formatDate(entry.data.date, entry.data.date_precision)}
              </p>
              <h3><a href={entryHref(collection, entry.data.id)}>{entryTitle(entry)}</a></h3>
              {entry.data.summary && <p>{entry.data.summary}</p>}
            </div>
          </li>
        );
      })}
    </ol>
  </section>

  <section class="home-section places-band" aria-labelledby="places-heading">
    <header class="section-header">
      <div>
        <p class="eyebrow">The geography</p>
        <h2 id="places-heading">Places</h2>
      </div>
      <a href={withBase('/map/')}>Open the map →</a>
    </header>
    <ul class="place-links">
      {featuredPlaces.map((place: any) => (
        <li><a href={entryHref('places', place.data.id)}>{place.data.name}</a></li>
      ))}
    </ul>
    <p class="section-tail"><a href={withBase('/places/')}>Browse all {places.length} indexed places →</a></p>
  </section>
</BaseLayout>
