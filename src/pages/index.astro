---
import { getCollection } from 'astro:content';
import linkPreviewCache from '../../archive/derived/link-previews.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import { entryHref, entryTitle, formatDate, formatType, mediaTypeFor, mediaTypeLabels, previewForEntry, relationToAuthorship, sortByDateDesc, sourceGroupFor, sourceGroupLabels, sourceTimelineDate } from '../lib/content';

const works = await getCollection('works');
const shows = (await getCollection('episodes')).filter((entry) => entry.data.type === 'show');
const screen = await getCollection('screen');
const appearances = await getCollection('appearances');
const literature = await getCollection('literature');
const events = await getCollection('events');
const sources = await getCollection('sources');
const curatedEntries = [
  ...events,
  ...works,
  ...shows,
  ...screen,
  ...appearances,
  ...literature,
];
const curatedSourceIds = new Set(curatedEntries.flatMap((entry) => entry.data.sources ?? []));
const timelineSources = sources.filter((entry) => !curatedSourceIds.has(entry.data.id));
const sourceAuthorshipFor = (entry: any, sourceGroup: string) => {
  if (entry.data.relation_to_bourdain) return relationToAuthorship(entry.data.relation_to_bourdain);
  const type = entry.data.type ?? '';
  if (['tumblr', 'medium', 'list', 'socials'].includes(sourceGroup)) return 'by';
  if (['tv', 'field-notes'].includes(sourceGroup)) return 'by';
  if (type.includes('interview') || ['podcast', 'panel', 'radio-interview', 'video', 'official-video', 'social-video', 'social-photo'].includes(type)) return 'by';
  return 'about';
};
const entries = [
  ...events.map((entry) => ({ entry, collection: 'events', authorship: relationToAuthorship(entry.data.relation_to_bourdain ?? 'featured'), sourceGroup: 'curated', timelineDate: { date: entry.data.date, precision: entry.data.date_precision } })),
  ...works.map((entry) => ({ entry, collection: 'works', authorship: relationToAuthorship(entry.data.relation_to_bourdain ?? 'authored'), sourceGroup: 'curated', timelineDate: { date: entry.data.date, precision: entry.data.date_precision } })),
  ...shows.map((entry) => ({ entry, collection: 'episodes', authorship: relationToAuthorship(entry.data.relation_to_bourdain ?? 'featured'), sourceGroup: 'curated', timelineDate: { date: entry.data.date, precision: entry.data.date_precision } })),
  ...screen.map((entry) => ({ entry, collection: 'screen', authorship: relationToAuthorship(entry.data.relation_to_bourdain ?? 'featured'), sourceGroup: 'curated', timelineDate: { date: entry.data.date, precision: entry.data.date_precision } })),
  ...appearances.map((entry) => ({ entry, collection: 'appearances', authorship: relationToAuthorship(entry.data.relation_to_bourdain ?? 'featured'), sourceGroup: 'curated', timelineDate: { date: entry.data.date, precision: entry.data.date_precision } })),
  ...literature.map((entry) => ({ entry, collection: 'literature', authorship: relationToAuthorship(entry.data.relation_to_bourdain ?? 'about'), sourceGroup: 'curated', timelineDate: { date: entry.data.date, precision: entry.data.date_precision } })),
  ...timelineSources.map((entry) => {
    const sourceGroup = sourceGroupFor(entry.data);
    return { entry, collection: 'sources', authorship: sourceAuthorshipFor(entry, sourceGroup), sourceGroup, timelineDate: sourceTimelineDate(entry.data) };
  }),
].sort((a, b) => {
  const left = { data: { date: a.timelineDate.date } };
  const right = { data: { date: b.timelineDate.date } };
  return sortByDateDesc(left, right);
});
const entriesWithFacets = entries.map((item) => {
  const mediaType = mediaTypeFor(item.entry.data, item.collection, item.sourceGroup);
  return { ...item, mediaType };
});
const countBy = (values: string[]) => values.reduce((counts, value) => ({ ...counts, [value]: (counts[value] ?? 0) + 1 }), {} as Record<string, number>);
const mediaCounts = countBy(entriesWithFacets.map(({ mediaType }) => mediaType));
const authorCounts = countBy(entriesWithFacets.map(({ authorship }) => authorship));
const mediaFilters = Object.keys(mediaCounts).sort((a, b) => (mediaTypeLabels[a] ?? a).localeCompare(mediaTypeLabels[b] ?? b));
const deathDate = '2018-06-08';
const isPosthumous = (entry: any) => {
  if (entry.data.tags?.includes('posthumous')) return true;
  if (!entry.data.date) return false;
  if (entry.data.date_precision === 'year') return entry.data.date > '2018';
  if (entry.data.date_precision === 'month') return entry.data.date > '2018-06';
  return entry.data.date > deathDate;
};
const yearForEntry = (date?: string | null) => date?.slice(0, 4) ?? 'Undated';
const searchableText = (entry: any, collection: string, authorship: string, sourceGroup: string, mediaType: string) =>
  [
    entryTitle(entry),
    entry.data.notes,
    entry.data.type,
    entry.data.publication,
    entry.data.host,
    entry.data.url,
    collection,
    authorship,
    sourceGroupLabels[sourceGroup],
    mediaTypeLabels[mediaType],
    entry.data.date,
    ...(entry.data.tags ?? []),
    ...(entry.data.people ?? []),
    ...(entry.data.places ?? []),
  ]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();
const featuredImageFor = (entry: any) => previewForEntry(entry, linkPreviewCache.previews).image ?? '';
const statusFor = (entry: any) => entry.data.status;
---
<BaseLayout title="Bourdain Archive">
  <section class="hero home-hero archive-intro">
    <h1>Anthony Bourdain</h1>
    <p>{entriesWithFacets.length} records.</p>
  </section>

  <section class="archive-index" aria-label="Archive index">
    <div class="archive-controls" aria-label="Search and filter controls">
      <div class="search-control archive-search">
        <label for="archive-search">Search</label>
        <div class="search-box">
          <span aria-hidden="true">⌕</span>
          <input id="archive-search" type="search" placeholder="Search title, place, source, tag..." data-search />
        </div>
      </div>

      <div class="quick-filters" aria-label="Media filters">
        <button class="pill is-active" type="button" data-filter-all>All</button>
        {mediaFilters.map((filter) => (
          <button class="pill" type="button" data-filter-media={filter}>
            {mediaTypeLabels[filter] ?? formatType(filter)} <span>{mediaCounts[filter] ?? 0}</span>
          </button>
        ))}
      </div>

      <label class="select-control compact-select" for="archive-author">
        <span>Relation</span>
        <select id="archive-author" data-author-select>
          <option value="">All</option>
          <option value="by">By / featuring ({authorCounts.by ?? 0})</option>
          <option value="about">About ({authorCounts.about ?? 0})</option>
        </select>
      </label>

      <label class="select-control compact-select" for="archive-sort">
        <span>Sort</span>
        <select id="archive-sort" data-sort-select>
          <option value="date-desc">Newest</option>
          <option value="date-asc">Oldest</option>
          <option value="title-asc">Title</option>
        </select>
      </label>

      <label class="toggle-control">
        <input type="checkbox" data-image-toggle />
        <span>Images</span>
      </label>
    </div>

    <div class="results-toolbar compact-toolbar">
      <p class="result-count" data-result-count>{entriesWithFacets.length} records</p>
      <button class="text-button" type="button" data-filter-clear>Reset</button>
    </div>

    <ol class="archive-list" data-stream>
        {entriesWithFacets.map(({ entry, collection, authorship, sourceGroup, timelineDate, mediaType }) => (
          <li
            class="archive-row"
            data-type={entry.data.type}
            data-media-type={mediaType}
            data-author={authorship}
            data-posthumous={isPosthumous(entry) ? 'true' : 'false'}
            data-source-group={sourceGroup}
            data-date={timelineDate.date ?? ''}
            data-date-label={formatDate(timelineDate.date, timelineDate.precision)}
            data-year={yearForEntry(timelineDate.date)}
            data-title={entryTitle(entry).toLowerCase()}
            data-source-label={sourceGroupLabels[sourceGroup] ?? sourceGroup}
            data-search-text={searchableText(entry, collection, authorship, sourceGroup, mediaType)}
          >
            <a class="row-main" href={entryHref(collection, entry.data.id)}>
              <span class="row-date">{formatDate(timelineDate.date, timelineDate.precision)}</span>
              <span class="row-title">{entryTitle(entry)}</span>
              <span class="row-meta">{mediaTypeLabels[mediaType] ?? formatType(mediaType)} · {formatType(entry.data.type)} · {sourceGroupLabels[sourceGroup] ?? sourceGroup}</span>
            </a>
            <span class="row-flags">
              {isPosthumous(entry) && <span class="row-flag">Posthumous</span>}
              {statusFor(entry) && statusFor(entry) !== 'confirmed' && <span class="row-flag">{statusFor(entry)}</span>}
            </span>
            {featuredImageFor(entry) && (
              <a class="row-image" href={entryHref(collection, entry.data.id)} tabindex="-1" aria-hidden="true">
                <img src={featuredImageFor(entry)} alt="" loading="lazy" />
              </a>
            )}
          </li>
        ))}
    </ol>
    <p class="no-results" data-no-results hidden>No matches. Clear filters or try a broader search.</p>
  </section>

  <script>
    const stream = document.querySelector<HTMLOListElement>('[data-stream]');
    const searchInput = document.querySelector<HTMLInputElement>('[data-search]');
    const countLabels = document.querySelectorAll<HTMLElement>('[data-result-count]');
    const noResults = document.querySelector<HTMLElement>('[data-no-results]');
    const clearButton = document.querySelector<HTMLButtonElement>('[data-filter-clear]');
    const mediaButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter-media]');
    const allButton = document.querySelector<HTMLButtonElement>('[data-filter-all]');
    const authorSelect = document.querySelector<HTMLSelectElement>('[data-author-select]');
    const sortSelect = document.querySelector<HTMLSelectElement>('[data-sort-select]');
    const imageToggle = document.querySelector<HTMLInputElement>('[data-image-toggle]');
    const items = Array.from(document.querySelectorAll<HTMLElement>('.archive-row'));
    const totalItems = items.length;
    const STORAGE_KEY = 'bourdain-archive.index-controls.v1';
    let sortMode = 'date-desc';
    let renderedSortMode = '';

    const activeValues = (buttons: NodeListOf<HTMLButtonElement>, attribute: string) =>
      Array.from(buttons)
        .filter((button) => button.classList.contains('is-active'))
        .map((button) => button.getAttribute(attribute))
        .filter(Boolean);

    const textValue = (item: HTMLElement, attr: string) => item.getAttribute(attr) ?? '';

    const compareDate = (left: HTMLElement, right: HTMLElement, direction: 'asc' | 'desc') => {
      const leftDate = textValue(left, 'data-date');
      const rightDate = textValue(right, 'data-date');
      if (!leftDate && !rightDate) return 0;
      if (!leftDate) return 1;
      if (!rightDate) return -1;
      return direction === 'asc' ? leftDate.localeCompare(rightDate) : rightDate.localeCompare(leftDate);
    };

    const compareTextThenDate = (attr: string) => (left: HTMLElement, right: HTMLElement) =>
      textValue(left, attr).localeCompare(textValue(right, attr)) || compareDate(left, right, 'desc');

    const compareItems = (left: HTMLElement, right: HTMLElement) => {
      if (sortMode === 'date-asc') return compareDate(left, right, 'asc');
      if (sortMode === 'title-asc') return compareTextThenDate('data-title')(left, right);
      if (sortMode === 'media-asc') return compareTextThenDate('data-media-type')(left, right);
      if (sortMode === 'author-asc') return compareTextThenDate('data-author')(left, right);
      return compareDate(left, right, 'desc');
    };

    const readSavedControls = () => {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '{}');
      } catch {
        return {};
      }
    };

    const saveControls = () => {
      try {
        localStorage.setItem(
          STORAGE_KEY,
          JSON.stringify({
            query: searchInput?.value ?? '',
            mediaTypes: activeValues(mediaButtons, 'data-filter-media'),
            author: authorSelect?.value ?? '',
            sort: sortMode,
            images: Boolean(imageToggle?.checked),
          }),
        );
      } catch {}
    };

    const applySavedControls = () => {
      const saved = readSavedControls();
      if (searchInput && typeof saved.query === 'string') searchInput.value = saved.query;
      if (Array.isArray(saved.mediaTypes)) {
        mediaButtons.forEach((button) => button.classList.toggle('is-active', saved.mediaTypes.includes(button.getAttribute('data-filter-media'))));
      }
      if (authorSelect && (saved.author === 'by' || saved.author === 'about')) authorSelect.value = saved.author;
      if (imageToggle) imageToggle.checked = Boolean(saved.images);

      const savedSort = saved.sort === 'asc' ? 'date-asc' : saved.sort === 'desc' ? 'date-desc' : saved.sort;
      if (['date-desc', 'date-asc', 'title-asc'].includes(savedSort)) sortMode = savedSort;
      if (sortSelect) sortSelect.value = sortMode;
    };

    const renderSortedItems = () => {
      if (!stream || renderedSortMode === sortMode) return;
      items.sort(compareItems).forEach((item) => stream.append(item));
      renderedSortMode = sortMode;
    };

    const updateControls = () => {
      const activeMediaTypes = activeValues(mediaButtons, 'data-filter-media');
      const activeAuthor = authorSelect?.value ?? '';
      const query = searchInput?.value.trim().toLowerCase() ?? '';

      allButton?.classList.toggle('is-active', activeMediaTypes.length === 0);
      stream?.classList.toggle('show-images', Boolean(imageToggle?.checked));
      renderSortedItems();

      let visibleCount = 0;
      items.forEach((item) => {
        const matchesMedia = activeMediaTypes.length === 0 || activeMediaTypes.includes(item.getAttribute('data-media-type'));
        const matchesAuthor = !activeAuthor || activeAuthor === item.getAttribute('data-author');
        const matchesQuery = !query || (item.getAttribute('data-search-text') ?? '').includes(query);
        const isVisible = matchesMedia && matchesAuthor && matchesQuery;
        item.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      });

      countLabels.forEach((label) => (label.textContent = `${visibleCount} of ${totalItems} records`));
      if (noResults) noResults.hidden = visibleCount > 0;
      saveControls();
    };

    clearButton?.addEventListener('click', () => {
      mediaButtons.forEach((button) => button.classList.remove('is-active'));
      if (searchInput) searchInput.value = '';
      if (authorSelect) authorSelect.value = '';
      if (imageToggle) imageToggle.checked = false;
      sortMode = 'date-desc';
      if (sortSelect) sortSelect.value = sortMode;
      renderedSortMode = '';
      updateControls();
    });

    allButton?.addEventListener('click', () => {
      mediaButtons.forEach((button) => button.classList.remove('is-active'));
      updateControls();
    });

    mediaButtons.forEach((button) => {
      button.addEventListener('click', () => {
        button.classList.toggle('is-active');
        updateControls();
      });
    });

    searchInput?.addEventListener('input', updateControls);
    authorSelect?.addEventListener('change', updateControls);
    imageToggle?.addEventListener('change', updateControls);

    sortSelect?.addEventListener('change', () => {
      sortMode = sortSelect.value;
      renderedSortMode = '';
      updateControls();
    });

    applySavedControls();
    updateControls();
  </script>
</BaseLayout>
