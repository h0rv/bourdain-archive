---
import { getCollection } from 'astro:content';
import linkPreviewCache from '../../../archive/derived/link-previews.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  entryHref,
  entryTitle,
  formatDate,
  previewForEntry,
  primaryAvailabilityUrl,
} from '../../lib/content';
import { withBase } from '../../lib/site';

const series = await getCollection('series');
const sources = await getCollection('sources');
const sourceById = new Map(sources.map((entry) => [entry.data.id, entry]));
const shows = series
  .filter((entry) => entry.data.type === 'show')
  .sort((left, right) => (left.data.date ?? '').localeCompare(right.data.date ?? ''));
const episodes = series.filter((entry) => entry.data.type === 'episode');

const previewFor = (entry: any) => {
  const own = previewForEntry(entry, linkPreviewCache.previews);
  if (own.image) return own;
  for (const sourceId of entry.data.sources ?? []) {
    const source = sourceById.get(sourceId);
    if (!source) continue;
    const sourcePreview = previewForEntry(source, linkPreviewCache.previews);
    if (sourcePreview.image) return { ...own, image: sourcePreview.image };
  }
  return own;
};
---

<BaseLayout
  title="Television"
  description="Anthony Bourdain’s television series, production roles, and indexed episode guides."
>
  <header class="page-intro split-intro">
    <div>
      <p class="eyebrow">Nine series · {episodes.length} episode records</p>
      <h1 class="page-title">Television</h1>
    </div>
    <p class="lede">
      Hosted, narrated, judged, or executive produced by Bourdain. Open a series for its full
      season-by-season episode index, or <a href={withBase('/archive/?scope=all')}>search every episode</a>.
    </p>
  </header>

  <ol class="show-index">
    {shows.map((show, index) => {
      const showEpisodes = episodes.filter((episode) => episode.data.parent_id === show.data.id);
      const seasons = new Set(showEpisodes.map((episode) => episode.data.season).filter(Boolean));
      const preview = previewFor(show);
      const officialUrl = primaryAvailabilityUrl(show.data);
      return (
        <li>
          <article class="show-catalog-card">
            <a class="show-poster" href={entryHref('series', show.data.id)}>
              {preview.image ? (
                <img
                  src={preview.image}
                  alt=""
                  loading={index < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                  width="400"
                  height="600"
                />
              ) : (
                <span>Television</span>
              )}
            </a>
            <div class="show-catalog-copy">
              <p class="eyebrow">
                {formatDate(show.data.date, show.data.date_precision)} · Featuring Bourdain
              </p>
              <h2><a href={entryHref('series', show.data.id)}>{entryTitle(show)}</a></h2>
              <p>{show.data.summary}</p>
              <dl class="show-counts">
                <div><dt>Seasons</dt><dd>{seasons.size || '—'}</dd></div>
                <div><dt>Episodes indexed</dt><dd>{showEpisodes.length || '—'}</dd></div>
              </dl>
              <p class="show-actions">
                <a class="primary-action" href={entryHref('series', show.data.id)}>Browse series</a>
                {officialUrl && <a href={officialUrl} rel="noopener noreferrer">Official / watch</a>}
              </p>
            </div>
          </article>
        </li>
      );
    })}
  </ol>

  <aside class="crosslink-band">
    <p class="eyebrow">Beyond the hosted series</p>
    <h2>Films, cameos, guest roles + long-form interviews</h2>
    <p><a href={withBase('/screen/')}>Browse screen and audio appearances →</a></p>
  </aside>
</BaseLayout>
