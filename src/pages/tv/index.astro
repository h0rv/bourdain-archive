---
import { getCollection } from 'astro:content';
import linkPreviewCache from '../../../archive/derived/link-previews.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  entryHref,
  entryTitle,
  formatDate,
  previewForEntry,
  primaryAvailabilityUrl,
} from '../../lib/content';
import { withBase } from '../../lib/site';

const series = await getCollection('series');
const sources = await getCollection('sources');
const sourceById = new Map(sources.map((entry) => [entry.data.id, entry]));
const shows = series.filter((entry) => entry.data.type === 'show');
const byId = new Map(shows.map((entry) => [entry.data.id, entry]));
const selectShows = (ids: string[]) => ids.map((id) => byId.get(id)).filter(Boolean);
const hostedShows = selectShows([
  'a-cooks-tour-show',
  'no-reservations-show',
  'the-layover-show',
  'parts-unknown-show',
]);
const otherHostedShows = selectShows(['raw-craft-show']);
const productionShows = selectShows(['mind-of-a-chef-show', 'the-getaway-show']);
const competitionShows = selectShows(['the-taste-show', 'top-chef-appearances']);
const roleLabels: Record<string, string> = {
  'a-cooks-tour-show': 'Host',
  'no-reservations-show': 'Host',
  'the-layover-show': 'Host',
  'parts-unknown-show': 'Host',
  'raw-craft-show': 'Host',
  'mind-of-a-chef-show': 'Narrator and executive producer',
  'the-getaway-show': 'Executive producer',
  'the-taste-show': 'Judge and mentor',
  'top-chef-appearances': 'Guest judge',
};

const previewFor = (entry: any) => {
  const own = previewForEntry(entry, linkPreviewCache.previews);
  if (own.image) return own;
  for (const sourceId of entry.data.sources ?? []) {
    const source = sourceById.get(sourceId);
    if (!source) continue;
    const sourcePreview = previewForEntry(source, linkPreviewCache.previews);
    if (sourcePreview.image) return { ...own, image: sourcePreview.image };
  }
  return own;
};
---

<BaseLayout
  title="Television"
  description="Television hosted, narrated, produced, or featuring Anthony Bourdain."
>
  <header class="page-intro">
    <h1 class="page-title">Television</h1>
  </header>

  {[
    { title: 'Hosted travel series', shows: hostedShows },
    { title: 'Other hosted work', shows: otherHostedShows },
    { title: 'Narrated and produced', shows: productionShows },
    { title: 'Competition and guest work', shows: competitionShows },
  ].map((group, groupIndex) => (
    <section class="tv-section" aria-labelledby={`tv-section-${groupIndex}`}>
      <header class="section-header">
        <h2 id={`tv-section-${groupIndex}`}>{group.title}</h2>
      </header>
      <ol class="show-index">
        {group.shows.map((show: any, index: number) => {
          const preview = previewFor(show);
          const officialUrl = primaryAvailabilityUrl(show.data);
          return (
            <li>
              <article class="show-catalog-card">
                <a class="show-poster" href={entryHref('series', show.data.id)}>
                  {preview.image ? (
                    <img
                      src={preview.image}
                      alt=""
                      loading={groupIndex === 0 && index < 2 ? 'eager' : 'lazy'}
                      decoding="async"
                      width="400"
                      height="600"
                    />
                  ) : (
                    <span>Television</span>
                  )}
                </a>
                <div class="show-catalog-copy">
                  <p class="eyebrow">
                    {formatDate(show.data.date, show.data.date_precision)}, {roleLabels[show.data.id]}
                  </p>
                  <h3><a href={entryHref('series', show.data.id)}>{entryTitle(show)}</a></h3>
                  <p>{show.data.summary}</p>
                  <p class="show-actions">
                    <a class="primary-action" href={entryHref('series', show.data.id)}>Open series</a>
                    {officialUrl && <a href={officialUrl} rel="noopener noreferrer">Official site</a>}
                  </p>
                </div>
              </article>
            </li>
          );
        })}
      </ol>
    </section>
  ))}

  <aside class="crosslink-band">
    <h2><a href={withBase('/screen/')}>Films and appearances</a></h2>
  </aside>
</BaseLayout>
