---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entryHref, entryTitle, formatDate, formatType } from '../../lib/content';
import { withBase } from '../../lib/site';

export async function getStaticPaths() {
  const places = await getCollection('places');
  const sources = await getCollection('sources');
  const referencedEntries = [
    ...(await getCollection('works')).map((entry) => ({ entry, collection: 'works' })),
    ...(await getCollection('series')).map((entry) => ({ entry, collection: 'series' })),
    ...(await getCollection('screen')).map((entry) => ({ entry, collection: 'screen' })),
    ...(await getCollection('appearances')).map((entry) => ({ entry, collection: 'appearances' })),
    ...(await getCollection('literature')).map((entry) => ({ entry, collection: 'literature' })),
    ...(await getCollection('events')).map((entry) => ({ entry, collection: 'events' })),
  ];

  return places.map((entry) => ({
    params: { id: entry.data.id },
    props: {
      entry,
      linkedEntries: referencedEntries
        .filter((item) => item.entry.data.places?.includes(entry.data.id))
        .sort((left, right) =>
          (right.entry.data.date ?? '').localeCompare(left.entry.data.date ?? ''),
        ),
      citedSources: (entry.data.sources ?? [])
        .map((id) => sources.find((source) => source.data.id === id))
        .filter(Boolean),
    },
  }));
}

const { entry, linkedEntries, citedSources } = Astro.props;
const data = entry.data;
---

<BaseLayout
  title={data.name}
  description={data.summary}
  noindex={data.status === 'needs-review' || data.status === 'missing-source'}
>
  <article class="place-detail">
    <header class="page-intro">
      {data.status !== 'confirmed' && <p class="eyebrow">{formatType(data.status)}</p>}
      <h1 class="page-title">{data.name}</h1>
      {data.summary && <p class="lede">{data.summary}</p>}
      <p class="home-actions">
        <a class="primary-action" href={withBase('/map/')}>Open travel map</a>
        <a href={withBase('/places/')}>All places</a>
      </p>
    </header>

    <section class="detail-box">
      <div class="section-title-row">
        <h2>Related work</h2>
      </div>
      {linkedEntries.length > 0 ? (
        <ol class="place-entry-list">
          {linkedEntries.map(({ entry: linkedEntry, collection }) => (
            <li>
              <span>{formatDate(linkedEntry.data.date, linkedEntry.data.date_precision)}</span>
              <a href={entryHref(collection, linkedEntry.data.id)}>{entryTitle(linkedEntry)}</a>
              <small>{formatType(linkedEntry.data.type)}</small>
            </li>
          ))}
        </ol>
      ) : (
        <p class="meta">No work is linked to this place yet.</p>
      )}
    </section>

    {citedSources.length > 0 && (
      <section class="detail-box">
        <h2>Sources</h2>
        <ol class="citation-list">
          {citedSources.map((source: any) => (
            <li>
              <div>
                <a class="citation-title" href={source.data.url} rel="noopener noreferrer">{source.data.title}</a>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}
  </article>
</BaseLayout>
