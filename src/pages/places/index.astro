---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entryHref } from '../../lib/content';
import '../../styles/catalog.css';

const places = await getCollection('places');
const referencedEntries = [
  ...(await getCollection('works')),
  ...(await getCollection('series')),
  ...(await getCollection('screen')),
  ...(await getCollection('appearances')),
  ...(await getCollection('literature')),
  ...(await getCollection('events')),
];

const counts = new Map<string, number>();
for (const entry of referencedEntries) {
  for (const placeId of new Set(entry.data.places ?? [])) {
    counts.set(placeId, (counts.get(placeId) ?? 0) + 1);
  }
}

const rows = places
  .map((entry) => ({
    entry,
    name: entry.data.name,
    count: counts.get(entry.data.id) ?? 0,
    searchable: [entry.data.name, entry.data.summary, ...(entry.data.tags ?? [])]
      .filter(Boolean)
      .join(' ')
      .toLocaleLowerCase(),
  }))
  .sort((left, right) => left.name.localeCompare(right.name));
---

<BaseLayout
  title="Places"
  description="An alphabetical list of places connected to Anthony Bourdain's work and travels."
>
  <div class="catalog-page" data-place-catalog>
    <header class="catalog-intro">
      <p class="eyebrow"><a href="../map/">Open the map</a></p>
      <h1 class="page-title">Place list</h1>
      <p>Search countries, cities, and regions from Bourdain's work.</p>
    </header>

    <form class="catalog-tools catalog-tools-compact" role="search">
      <label class="catalog-field">
        <span>Search places</span>
        <input type="search" placeholder="City, country, or region" autocomplete="off" data-place-search />
      </label>
      <label class="catalog-field">
        <span>References</span>
        <select data-place-usage>
          <option value="">All places</option>
          <option value="referenced">With related work</option>
          <option value="unreferenced">Without related work</option>
        </select>
      </label>
    </form>

    <div class="catalog-toolbar">
      <p class="catalog-count"><a href="../map/">Open the map</a></p>
    </div>

    <ol class="catalog-source-list">
      {rows.map((row) => (
        <li
          class="catalog-source-row"
          data-place-item
          data-search={row.searchable}
          data-count={row.count}
        >
          <div class="catalog-source-copy">
            <a href={entryHref('places', row.entry.data.id)}>{row.name}</a>
            {row.entry.data.summary && <span class="catalog-source-host">{row.entry.data.summary}</span>}
          </div>
        </li>
      ))}
    </ol>
    <p class="catalog-empty" data-place-empty hidden>No matching places.</p>
  </div>

  <script>
    const root = document.querySelector<HTMLElement>('[data-place-catalog]');
    const search = root?.querySelector<HTMLInputElement>('[data-place-search]');
    const usage = root?.querySelector<HTMLSelectElement>('[data-place-usage]');
    const items = [...(root?.querySelectorAll<HTMLElement>('[data-place-item]') ?? [])];
    const empty = root?.querySelector<HTMLElement>('[data-place-empty]');

    const apply = () => {
      const query = search?.value.trim().toLocaleLowerCase() ?? '';
      let visible = 0;
      for (const item of items) {
        const references = Number(item.dataset.count ?? 0);
        const usageMatches =
          !usage?.value ||
          (usage.value === 'referenced' && references > 0) ||
          (usage.value === 'unreferenced' && references === 0);
        const matches = (!query || item.dataset.search?.includes(query)) && usageMatches;
        item.hidden = !matches;
        if (matches) visible += 1;
      }
      if (empty) empty.hidden = visible !== 0;
    };

    root?.querySelector('form')?.addEventListener('input', apply);
    root?.querySelector('form')?.addEventListener('change', apply);
    root?.querySelector('form')?.addEventListener('submit', (event) => event.preventDefault());
  </script>
</BaseLayout>
