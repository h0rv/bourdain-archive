---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/site';
const mapDataUrl = withBase('/archive/derived/travel-places.json');
---
<BaseLayout title="Map">
  <link rel="stylesheet" href={withBase('/vendor/leaflet/leaflet.css')} />
  <style is:global>
    .map-shell {
      display: grid;
      grid-template-columns: 360px minmax(0,1fr);
      /* Header is 56px logo + top-bar padding (0.8rem+0.9rem). site-main adds ~1rem top padding. */
      height: calc(100vh - 56px - 2.5rem);
      min-height: 520px;
      border: 1px solid rgba(17,16,14,0.08);
      border-radius: 16px;
      background: var(--cream);
      box-shadow:
        0 1px 2px rgba(17,16,14,0.04),
        0 8px 24px rgba(17,16,14,0.06);
      overflow: hidden;
    }
    .map-list {
      display: flex;
      flex-direction: column;
      border-right: 1px solid rgba(17,16,14,0.08);
      background: var(--cream);
      min-width: 0;
      overflow: hidden;
    }
    .map-list-head {
      padding: 0.9rem 0.9rem 0.75rem;
      border-bottom: 1px solid rgba(17,16,14,0.08);
      display: grid;
      gap: 0.6rem;
      background: color-mix(in srgb, var(--cream) 92%, white);
    }
    .map-list-head h1 {
      margin: 0;
      font-family: var(--sans);
      font-size: 1.05rem;
      font-weight: 800;
      letter-spacing: -0.025em;
      line-height: 1.1;
      color: var(--ink);
    }
    .map-search {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.5rem;
      align-items: center;
    }
    .map-search input {
      width: 100%;
      min-width: 0;
      padding: 0.65rem 0.75rem;
      border: 1px solid rgba(17,16,14,0.12);
      border-radius: 10px;
      background: var(--bg);
      font-family: var(--sans);
      font-size: 0.88rem;
      line-height: 1.3;
      color: var(--ink);
      transition: border-color 150ms ease, box-shadow 150ms ease;
    }
    .map-search input::placeholder { color: var(--muted); opacity: 0.9; }
    .map-search input:focus {
      outline: none;
      border-color: rgba(168,50,29,0.32);
      box-shadow: 0 0 0 3px rgba(168,50,29,0.10);
    }
    .small-btn {
      padding: 0.58rem 0.7rem;
      border: 1px solid rgba(17,16,14,0.12);
      border-radius: 999px;
      background: var(--ink);
      color: var(--cream);
      font-family: var(--sans);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      line-height: 1;
      text-transform: uppercase;
      cursor: pointer;
      white-space: nowrap;
      box-shadow: 0 1px 2px rgba(17,16,14,0.08);
      transition: transform 120ms ease, box-shadow 120ms ease, background 120ms ease, border-color 120ms ease;
    }
    .small-btn:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(17,16,14,0.12); }
    .small-btn:active { transform: none; }
    .small-btn.secondary {
      background: var(--bg);
      color: var(--ink);
      border-color: rgba(17,16,14,0.12);
    }
    .small-btn.secondary:hover { background: var(--cream); border-color: rgba(17,16,14,0.18); }
    .map-results {
      overflow: auto;
      padding: 0.5rem;
      margin: 0;
      list-style: none;
      display: grid;
      gap: 0.4rem;
      align-content: start;
      scrollbar-width: thin;
      scrollbar-color: rgba(17,16,14,0.18) transparent;
    }
    .map-result-button {
      display: block;
      width: 100%;
      padding: 0.7rem 0.75rem;
      border: 1px solid rgba(17,16,14,0.06);
      border-radius: 12px;
      background: var(--bg);
      color: var(--ink);
      font: inherit;
      text-align: left;
      cursor: pointer;
      min-width: 0;
      overflow: hidden;
      box-shadow: 0 1px 1px rgba(17,16,14,0.04);
      transition: background 140ms ease, border-color 140ms ease, box-shadow 140ms ease, transform 140ms ease;
    }
    .map-result-button:hover {
      background: var(--cream);
      border-color: rgba(17,16,14,0.10);
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(17,16,14,0.07);
    }
    .map-results li.is-active .map-result-button {
      background: var(--ink);
      border-color: var(--ink);
      color: var(--cream);
      box-shadow: 0 8px 20px rgba(17,16,14,0.14);
    }
    .map-results li strong,
    .map-results li .place-title {
      display: block;
      min-width: 0;
      font-family: var(--sans);
      font-size: 0.93rem;
      font-weight: 750;
      line-height: 1.35;
      letter-spacing: -0.015em;
      overflow-wrap: anywhere;
      word-break: break-word;
      hyphens: auto;
    }
    .map-results li .place-meta,
    .map-results li span {
      display: block;
      min-width: 0;
      margin-top: 0.22rem;
      color: var(--muted);
      font-family: var(--sans);
      font-size: 0.72rem;
      font-weight: 500;
      line-height: 1.45;
      letter-spacing: 0.01em;
      text-transform: none;
      overflow-wrap: anywhere;
      word-break: break-word;
      hyphens: auto;
    }
    .map-results li.is-active .place-meta,
    .map-results li.is-active span {
      color: color-mix(in srgb, var(--cream) 82%, white);
    }
    .map-view { position: relative; min-width: 0; background: var(--wash); }
    #map { width: 100%; height: 100%; background: var(--wash); }
    /* Leaflet modern polish */
    .leaflet-container { font-family: var(--sans); background: var(--wash); }
    .leaflet-popup-content-wrapper { border-radius: 12px; box-shadow: 0 8px 24px rgba(17,16,14,0.12); }
    .leaflet-popup-content { font-family: var(--sans); line-height: 1.4; margin: 12px 16px; overflow-wrap: anywhere; }
    .map-hint {
      position: absolute;
      top: 0.75rem;
      left: 50%;
      transform: translateX(-50%);
      background: color-mix(in srgb, var(--cream) 92%, white);
      border: 1px solid rgba(17,16,14,0.08);
      border-radius: 999px;
      padding: 0.38rem 0.7rem;
      font-family: var(--sans);
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      color: var(--muted);
      box-shadow: 0 4px 12px rgba(17,16,14,0.08);
      backdrop-filter: blur(6px);
      z-index: 400;
      white-space: nowrap;
    }
    @media (max-width: 820px){
      .map-shell { grid-template-columns: 1fr; height: auto; border-radius: 12px; }
      .map-view { height: 55vh; min-height: 360px; }
      .map-results { max-height: 42vh; }
    }
  </style>

  <div class="map-shell" data-url={mapDataUrl}>
    <div class="map-list">
      <div class="map-list-head">
        <h1>Map</h1>
        <div class="map-search">
          <label for="q" class="sr-only">Filter places</label>
          <input id="q" type="search" placeholder="Filter city, country, show..." autocomplete="off" aria-label="Filter places by city, country or show" />
          <button id="search-area" class="small-btn" type="button">Search this area</button>
        </div>
        <div style="display:flex;gap:0.4rem;align-items:center">
          <button id="reset" class="small-btn secondary" type="button">Reset view</button>
          <span id="count" class="meta" role="status" aria-live="polite" style="align-self:center; margin-left:auto; font-family: var(--sans); font-size: 0.72rem; color: var(--muted);"></span>
        </div>
      </div>
      <ol id="results" class="map-results" aria-label="Place results"></ol>
    </div>
    <div class="map-view">
      <div id="map" role="region" aria-label="Map of Bourdain travels"></div>
      <div class="map-hint" aria-hidden="true">Pan and zoom · Click list to fly</div>
    </div>
  </div>
  <noscript><p class="meta" style="margin-top:0.75rem">Map requires JavaScript. Browse the <a href={withBase('/places/')}>places list</a> without the map.</p></noscript>

  <script is:inline src={withBase('/vendor/leaflet/leaflet.js')}></script>
  <script>
    // @ts-nocheck
    const dataUrl = document.querySelector('.map-shell')?.getAttribute('data-url') || '/archive/derived/travel-places.json';
    const map = L.map('map', { zoomControl:true }).setView([20, 0], 2);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; OpenStreetMap &copy; CARTO',
      subdomains: 'abcd',
      maxZoom: 19
    }).addTo(map);

    const resultsEl = document.getElementById('results');
    const qEl = document.getElementById('q');
    const countEl = document.getElementById('count');
    const searchAreaBtn = document.getElementById('search-area');
    const resetBtn = document.getElementById('reset');

    let all = [];
    let markers = [];
    let markerById = new Map();

    function renderList(items){
      resultsEl.replaceChildren();
      countEl.textContent = `${items.length} places`;
      items.forEach((r, i) => {
        const li = document.createElement('li');
        li.dataset.idx = i;
        const button = document.createElement('button');
        button.className = 'map-result-button';
        button.type = 'button';
        const placeLabel = `${r.city}${r.state ? ', ' + r.state : ''}, ${r.country}`;
        const metaLabel = `${r.show} · S${r.season}E${r.episode} · ${r.title}`;
        const title = document.createElement('strong');
        title.className = 'place-title';
        title.textContent = placeLabel;
        const meta = document.createElement('span');
        meta.className = 'place-meta';
        meta.textContent = metaLabel;
        button.append(title, meta);
        button.addEventListener('click', () => {
          document.querySelectorAll('#results li').forEach(el=>el.classList.remove('is-active'));
          li.classList.add('is-active');
          const m = markerById.get(r._id);
          if (m) { map.flyTo(m.getLatLng(), Math.max(map.getZoom(), 5), {duration:0.9}); m.openPopup(); }
        });
        li.append(button);
        resultsEl.appendChild(li);
      });
    }

    function filterByText(items, q){
      if (!q) return items;
      q = q.toLowerCase();
      return items.filter(r => `${r.city} ${r.country} ${r.show} ${r.title} ${r.region}`.toLowerCase().includes(q));
    }
    function filterByBounds(items){
      const b = map.getBounds();
      return items.filter(r => b.contains([r.latitude, r.longitude]));
    }

    function syncMarkers(items){
      markers.forEach(m=>map.removeLayer(m));
      markers = [];
      markerById.clear();
      items.forEach((r) => {
        const m = L.circleMarker([r.latitude, r.longitude], {
          radius: 6,
          weight: 2,
          color: '#ffffff',
          opacity: 1,
          fillColor: '#a8321d',
          fillOpacity: 0.92
        }).addTo(map);
        const popup = document.createElement('div');
        const popupTitle = document.createElement('strong');
        popupTitle.textContent = `${r.city}, ${r.country}`;
        const popupMeta = document.createElement('span');
        popupMeta.textContent = `${r.show} S${r.season}E${r.episode} — ${r.title}`;
        const sourceLink = document.createElement('a');
        sourceLink.textContent = 'Source';
        try {
          const sourceUrl = new URL(r.source_url);
          if (sourceUrl.protocol === 'https:' || sourceUrl.protocol === 'http:') {
            sourceLink.href = sourceUrl.href;
            sourceLink.target = '_blank';
            sourceLink.rel = 'noopener noreferrer';
          }
        } catch {
          sourceLink.hidden = true;
        }
        popup.append(popupTitle, document.createElement('br'), popupMeta, document.createElement('br'), sourceLink);
        m.bindPopup(popup, { maxWidth: 260 });
        markers.push(m);
        markerById.set(r._id, m);
      });
    }

    async function load(){
      try {
        const j = await fetch(dataUrl).then(r=>{ if(!r.ok) throw new Error(`HTTP ${r.status}`); return r.json(); });
        const raw = (j.records || j).filter(r=> r.latitude && r.longitude);
        // dedupe: Azores 4 islands share same S5E4 city=Azores; collapse to one per show/season/episode/city
        const seen = new Map();
        raw.forEach(r=>{
          const key = `${r.city}|${r.country}|${r.show}|${r.season}|${r.episode}`;
          if (!seen.has(key)) {
            // merge Azores island titles into one label
            if (r.city==='Azores' && r.country==='Portugal' && r.show==='No Reservations' && r.season===5 && r.episode===4) {
              r.title = 'Azores (Sao Miguel, Faial, Pico, Sao Jorge)';
            }
            seen.set(key, r);
          }
        });
        all = [...seen.values()].map((r,idx)=> ({...r, _id: idx} ));
      } catch (e) {
        console.error('Map data failed to load', dataUrl, e);
        // fallback: try relative without base (useful for local file:// or dev)
        try {
          const j2 = await fetch('/archive/derived/travel-places.json').then(r=>r.json()).catch(()=>null)
            || await fetch('archive/derived/travel-places.json').then(r=>r.json()).catch(()=>null);
          if (j2) {
            const raw2 = (j2.records || j2).filter(r=> r.latitude && r.longitude);
            const seen2 = new Map();
            raw2.forEach(r=>{
              const key = `${r.city}|${r.country}|${r.show}|${r.season}|${r.episode}`;
              if (!seen2.has(key)) {
                if (r.city==='Azores' && r.country==='Portugal' && r.show==='No Reservations' && r.season===5 && r.episode===4) {
                  r.title = 'Azores (Sao Miguel, Faial, Pico, Sao Jorge)';
                }
                seen2.set(key, r);
              }
            });
            all = [...seen2.values()].map((r,idx)=> ({...r, _id: idx} ));
          }
        } catch {}
        if (!all.length) {
          const emptyItem = document.createElement('li');
          const emptyTitle = document.createElement('strong');
          emptyTitle.className = 'place-title';
          emptyTitle.textContent = 'No places found';
          const emptyMessage = document.createElement('span');
          emptyMessage.className = 'place-meta';
          emptyMessage.textContent = 'Could not load the travel index. Try the accessible places list instead.';
          emptyItem.append(emptyTitle, emptyMessage);
          resultsEl.replaceChildren(emptyItem);
          countEl.textContent = '0 places';
          return;
        }
      }
      renderList(all);
      syncMarkers(all);
      if (all.length) {
        const group = L.featureGroup(markers);
        try { map.fitBounds(group.getBounds().pad(0.12)); } catch {}
      }
    }

    qEl.addEventListener('input', () => {
      const filtered = filterByText(all, qEl.value);
      renderList(filtered);
      syncMarkers(filtered);
    });
    searchAreaBtn.addEventListener('click', () => {
      const filtered = filterByText(filterByBounds(all), qEl.value);
      renderList(filtered);
      syncMarkers(filtered);
    });
    resetBtn.addEventListener('click', () => {
      qEl.value = '';
      renderList(all);
      syncMarkers(all);
      const g = L.featureGroup(markers);
      try { map.fitBounds(g.getBounds().pad(0.12)); } catch {}
    });

    load();
  </script>
</BaseLayout>
