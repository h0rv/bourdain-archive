---
import 'maplibre-gl/dist/maplibre-gl.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/site';

const mapDataUrl = withBase('/archive/derived/travel-places.json');
const mapWorkerUrl = withBase('/vendor/maplibre/maplibre-gl-worker.js');
---

<BaseLayout
  title="Places map"
  description="Explore the cities, countries, and regions visited in Anthony Bourdain's television work."
>
  <div class="places-map-page" data-url={mapDataUrl} data-worker-url={mapWorkerUrl}>
    <h1 class="sr-only">Places visited by Anthony Bourdain</h1>

    <aside class="map-panel" aria-label="Place search">
      <div class="map-panel-head">
        <div class="map-panel-title">
          <span class="map-panel-label">Places</span>
          <button
            id="panel-toggle"
            class="panel-toggle"
            type="button"
            aria-controls="map-results-wrap"
            aria-expanded="true"
          >
            Hide list
          </button>
        </div>

        <label class="sr-only" for="place-search">Find a place or episode</label>
        <input
          id="place-search"
          class="place-search"
          type="search"
          placeholder="Find a place or episode"
          autocomplete="off"
          spellcheck="false"
        />

        <div class="map-actions">
          <button id="search-area" type="button">Show places on map</button>
          <button id="reset" type="button">Reset</button>
        </div>
      </div>

      <div id="map-results-wrap" class="map-results-wrap">
        <ol id="results" class="map-results" aria-label="Places"></ol>
      </div>
    </aside>

    <div class="map-view">
      <div id="map" role="region" aria-label="Interactive map of places visited"></div>
      <p id="map-error" class="map-error" hidden>
        The map could not load. You can still use the place list.
      </p>
    </div>
  </div>

  <noscript>
    <p class="map-noscript">
      The map needs JavaScript. You can use the <a href={withBase('/places/')}>place list</a>
      instead.
    </p>
  </noscript>

  <style is:global>
    body:has(.places-map-page) {
      overflow: hidden;
    }

    body:has(.places-map-page) .site-main {
      width: 100%;
      max-width: none;
      min-height: 0;
      padding: 0;
      margin: 0;
    }

    body:has(.places-map-page) .site-footer {
      display: none;
    }

    .places-map-page {
      --panel-width: 17.5rem;
      display: grid;
      grid-template-columns: var(--panel-width) minmax(0, 1fr);
      width: 100%;
      height: calc(100dvh - var(--map-header-height, 5.3rem));
      min-height: 32rem;
      background: #e7e1d5;
      overflow: hidden;
    }

    .map-panel {
      position: relative;
      z-index: 5;
      display: flex;
      min-width: 0;
      min-height: 0;
      flex-direction: column;
      background: var(--bg);
      border-right: 1px solid var(--rule);
    }

    .map-panel-head {
      display: grid;
      gap: 0.65rem;
      padding: 0.8rem;
      border-bottom: 1px solid var(--rule);
      background: var(--bg);
    }

    .map-panel-title,
    .map-actions {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      justify-content: space-between;
    }

    .map-panel-label {
      color: var(--muted);
      font-family: var(--mono);
      font-size: 0.66rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .panel-toggle {
      display: none;
    }

    .place-search {
      width: 100%;
      min-width: 0;
      min-height: 2.65rem;
      padding: 0.6rem 0.7rem;
      color: var(--ink);
      background: #fffdf8;
      border: 1px solid var(--rule-strong);
      border-radius: 0;
      font: 0.85rem/1.3 var(--sans);
    }

    .place-search::placeholder {
      color: var(--muted);
    }

    .place-search:focus {
      outline: 2px solid var(--accent);
      outline-offset: 1px;
    }

    .map-actions button,
    .panel-toggle {
      min-height: 2rem;
      padding: 0.35rem 0;
      color: var(--ink);
      background: transparent;
      border: 0;
      border-bottom: 1px solid var(--rule-strong);
      font-family: var(--mono);
      font-size: 0.62rem;
      font-weight: 600;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      cursor: pointer;
    }

    .map-actions button:hover,
    .panel-toggle:hover {
      color: var(--accent);
      border-bottom-color: var(--accent);
    }

    .map-results-wrap {
      min-height: 0;
      flex: 1;
      overflow: hidden;
    }

    .map-results {
      height: 100%;
      padding: 0;
      margin: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      list-style: none;
    }

    .map-result-button {
      display: block;
      width: 100%;
      padding: 0.7rem 0.8rem 0.75rem;
      color: var(--ink);
      background: transparent;
      border: 0;
      border-bottom: 1px solid var(--rule);
      font: inherit;
      text-align: left;
      cursor: pointer;
    }

    .map-result-button:hover,
    .map-result-button:focus-visible {
      background: #f4eee2;
      outline: none;
    }

    .map-results li.is-active .map-result-button {
      color: #fffdf8;
      background: var(--ink);
    }

    .place-title,
    .place-meta {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .place-title {
      font-family: var(--sans);
      font-size: 0.86rem;
      font-weight: 700;
      line-height: 1.25;
      white-space: nowrap;
    }

    .place-meta {
      margin-top: 0.2rem;
      color: var(--muted);
      font-family: var(--sans);
      font-size: 0.7rem;
      line-height: 1.35;
      white-space: nowrap;
    }

    .map-results li.is-active .place-meta {
      color: #d9d0c1;
    }

    .map-view,
    #map {
      width: 100%;
      min-width: 0;
      height: 100%;
    }

    .map-view {
      position: relative;
      background: #deddd5;
    }

    .maplibregl-map {
      font-family: var(--sans);
    }

    .maplibregl-ctrl-top-right {
      top: 0.5rem;
      right: 0.5rem;
    }

    .maplibregl-ctrl-group,
    .maplibregl-popup-content {
      border: 1px solid rgba(17, 16, 14, 0.16);
      border-radius: 0;
      box-shadow: 0 2px 10px rgba(17, 16, 14, 0.12);
    }

    .maplibregl-popup-content {
      min-width: 12rem;
      padding: 0.8rem 0.9rem;
      color: var(--ink);
      background: #fffdf8;
    }

    .map-popup-title {
      display: block;
      padding-right: 0.75rem;
      font-family: var(--sans);
      font-size: 0.9rem;
      line-height: 1.25;
    }

    .map-popup-meta {
      display: block;
      margin-top: 0.3rem;
      color: var(--muted);
      font-family: var(--sans);
      font-size: 0.72rem;
      line-height: 1.4;
    }

    .map-popup-link {
      display: inline-block;
      margin-top: 0.55rem;
      font-family: var(--mono);
      font-size: 0.62rem;
      font-weight: 600;
      text-transform: uppercase;
    }

    .maplibregl-ctrl-attrib {
      color: #4b4841;
      background: rgba(255, 253, 248, 0.9);
      font-size: 0.62rem;
    }

    .map-error {
      position: absolute;
      inset: 1rem auto auto 50%;
      z-index: 4;
      width: max-content;
      max-width: calc(100% - 2rem);
      padding: 0.6rem 0.8rem;
      margin: 0;
      color: var(--ink);
      background: #fffdf8;
      border: 1px solid var(--rule-strong);
      font-family: var(--sans);
      font-size: 0.78rem;
      transform: translateX(-50%);
    }

    .map-noscript {
      padding: 1rem;
    }

    @media (max-width: 760px) {
      .places-map-page {
        position: relative;
        display: block;
        min-height: 30rem;
      }

      .map-view {
        position: absolute;
        inset: 0;
      }

      .map-panel {
        position: absolute;
        inset: auto 0 0;
        z-index: 6;
        max-height: min(42dvh, 23rem);
        border-top: 1px solid var(--rule-strong);
        border-right: 0;
      }

      .map-panel-head {
        padding: 0.65rem 0.75rem;
      }

      .panel-toggle {
        display: inline-block;
      }

      .map-panel.is-collapsed .map-panel-head {
        grid-template-columns: 1fr;
      }

      .map-panel.is-collapsed .place-search,
      .map-panel.is-collapsed .map-actions,
      .map-panel.is-collapsed .map-results-wrap {
        display: none;
      }

      .maplibregl-ctrl-bottom-right {
        bottom: 3.2rem;
      }
    }
  </style>

  <script>
    import * as maplibregl from 'maplibre-gl';

    type PlaceRecord = {
      _id: number;
      city: string;
      state?: string | null;
      country: string;
      region?: string | null;
      show: string;
      title: string;
      season: number;
      episode: number;
      latitude: number;
      longitude: number;
      source_url?: string | null;
    };

    const shell = document.querySelector<HTMLElement>('.places-map-page');
    const panel = document.querySelector<HTMLElement>('.map-panel');
    const resultsEl = document.querySelector<HTMLOListElement>('#results');
    const searchEl = document.querySelector<HTMLInputElement>('#place-search');
    const searchAreaButton = document.querySelector<HTMLButtonElement>('#search-area');
    const resetButton = document.querySelector<HTMLButtonElement>('#reset');
    const panelToggle = document.querySelector<HTMLButtonElement>('#panel-toggle');
    const errorEl = document.querySelector<HTMLElement>('#map-error');
    const dataUrl = shell?.dataset.url;
    const workerUrl = shell?.dataset.workerUrl;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let allPlaces: PlaceRecord[] = [];
    let visiblePlaces: PlaceRecord[] = [];
    let activeId: number | null = null;
    let mapReady = false;

    function setPageHeight() {
      const headerHeight = document.querySelector('body > header')?.getBoundingClientRect().height ?? 0;
      document.documentElement.style.setProperty('--map-header-height', `${headerHeight}px`);
    }

    setPageHeight();
    window.addEventListener('resize', setPageHeight, { passive: true });

    if (workerUrl) maplibregl.setWorkerUrl(workerUrl);

    const map = new maplibregl.Map({
      container: 'map',
      style: 'https://tiles.openfreemap.org/styles/positron',
      center: [10, 18],
      zoom: 1.35,
      minZoom: 1,
      maxZoom: 15,
      renderWorldCopies: false,
      attributionControl: { compact: true },
      transformRequest: (url, resourceType) => {
        if (resourceType === 'Glyphs' && url.startsWith('https://tiles.openfreemap.org/fonts/')) {
          const range = url.slice(url.lastIndexOf('/') + 1);
          return { url: `https://tiles.openfreemap.org/fonts/Noto%20Sans%20Regular/${range}` };
        }
        return { url };
      },
    });

    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');

    function placeLabel(place: PlaceRecord) {
      const area = place.state ? `${place.city}, ${place.state}` : place.city;
      return `${area}, ${place.country}`;
    }

    function episodeLabel(place: PlaceRecord) {
      return `${place.show}, S${place.season}E${place.episode}, ${place.title}`;
    }

    function toGeoJSON(items: PlaceRecord[]): GeoJSON.FeatureCollection<GeoJSON.Point> {
      return {
        type: 'FeatureCollection',
        features: items.map((place) => ({
          type: 'Feature',
          id: place._id,
          geometry: {
            type: 'Point',
            coordinates: [place.longitude, place.latitude],
          },
          properties: {
            id: place._id,
            label: placeLabel(place),
          },
        })),
      };
    }

    function selectListItem(id: number, scroll = false) {
      activeId = id;
      resultsEl?.querySelectorAll('li').forEach((item) => {
        item.classList.toggle('is-active', Number((item as HTMLElement).dataset.id) === id);
      });
      if (scroll) {
        resultsEl
          ?.querySelector<HTMLElement>(`li[data-id="${id}"]`)
          ?.scrollIntoView({ block: 'nearest' });
      }
    }

    function showPopup(place: PlaceRecord) {
      const popup = document.createElement('div');
      const title = document.createElement('strong');
      const meta = document.createElement('span');
      title.className = 'map-popup-title';
      meta.className = 'map-popup-meta';
      title.textContent = placeLabel(place);
      meta.textContent = episodeLabel(place);
      popup.append(title, meta);

      if (place.source_url) {
        try {
          const url = new URL(place.source_url);
          if (url.protocol === 'https:' || url.protocol === 'http:') {
            const link = document.createElement('a');
            link.className = 'map-popup-link';
            link.href = url.href;
            link.target = '_blank';
            link.rel = 'noopener noreferrer';
            link.textContent = 'Episode page';
            popup.append(link);
          }
        } catch {
          // Ignore malformed source URLs.
        }
      }

      new maplibregl.Popup({ closeButton: true, maxWidth: '17rem', offset: 10 })
        .setLngLat([place.longitude, place.latitude])
        .setDOMContent(popup)
        .addTo(map);
    }

    function renderList(items: PlaceRecord[]) {
      if (!resultsEl) return;
      const fragment = document.createDocumentFragment();
      items.forEach((place) => {
        const item = document.createElement('li');
        const button = document.createElement('button');
        const title = document.createElement('strong');
        const meta = document.createElement('span');
        item.dataset.id = String(place._id);
        item.classList.toggle('is-active', place._id === activeId);
        button.type = 'button';
        button.className = 'map-result-button';
        button.setAttribute('aria-label', `${placeLabel(place)}. ${episodeLabel(place)}`);
        title.className = 'place-title';
        meta.className = 'place-meta';
        title.textContent = placeLabel(place);
        meta.textContent = episodeLabel(place);
        button.append(title, meta);
        button.addEventListener('click', () => {
          selectListItem(place._id);
          map.flyTo({
            center: [place.longitude, place.latitude],
            zoom: Math.max(map.getZoom(), 6),
            duration: reduceMotion ? 0 : 750,
          });
          showPopup(place);
          if (window.innerWidth <= 760) setPanelCollapsed(true);
        });
        item.append(button);
        fragment.append(item);
      });
      resultsEl.replaceChildren(fragment);
    }

    function updateMapSource(items: PlaceRecord[]) {
      if (!mapReady) return;
      const source = map.getSource('places') as maplibregl.GeoJSONSource | undefined;
      source?.setData(toGeoJSON(items));
    }

    function textMatches(place: PlaceRecord, query: string) {
      if (!query) return true;
      const haystack = [
        place.city,
        place.state,
        place.country,
        place.region,
        place.show,
        place.title,
      ]
        .filter(Boolean)
        .join(' ')
        .toLocaleLowerCase();
      return haystack.includes(query.toLocaleLowerCase());
    }

    function applyTextFilter() {
      const query = searchEl?.value.trim() ?? '';
      visiblePlaces = allPlaces.filter((place) => textMatches(place, query));
      activeId = null;
      renderList(visiblePlaces);
      updateMapSource(visiblePlaces);
    }

    function setPanelCollapsed(collapsed: boolean) {
      if (!panel || !panelToggle) return;
      panel.classList.toggle('is-collapsed', collapsed);
      panelToggle.textContent = collapsed ? 'Show list' : 'Hide list';
      panelToggle.setAttribute('aria-expanded', String(!collapsed));
      window.setTimeout(() => map.resize(), 0);
    }

    map.on('load', () => {
      mapReady = true;
      map.addSource('places', {
        type: 'geojson',
        data: toGeoJSON(visiblePlaces),
        cluster: true,
        clusterMaxZoom: 7,
        clusterRadius: 34,
      });

      map.addLayer({
        id: 'place-clusters',
        type: 'circle',
        source: 'places',
        filter: ['has', 'point_count'],
        paint: {
          'circle-color': '#a8321d',
          'circle-radius': ['step', ['get', 'point_count'], 15, 20, 19, 60, 23],
          'circle-stroke-width': 2,
          'circle-stroke-color': '#fffdf8',
          'circle-opacity': 0.92,
        },
      });

      map.addLayer({
        id: 'cluster-count',
        type: 'symbol',
        source: 'places',
        filter: ['has', 'point_count'],
        layout: {
          'text-field': ['get', 'point_count_abbreviated'],
          'text-size': 11,
        },
        paint: { 'text-color': '#fffdf8' },
      });

      map.addLayer({
        id: 'place-points',
        type: 'circle',
        source: 'places',
        filter: ['!', ['has', 'point_count']],
        paint: {
          'circle-color': '#a8321d',
          'circle-radius': 5,
          'circle-stroke-width': 2,
          'circle-stroke-color': '#fffdf8',
        },
      });

      map.on('click', 'place-clusters', async (event) => {
        const feature = map.queryRenderedFeatures(event.point, { layers: ['place-clusters'] })[0];
        const clusterId = feature?.properties?.cluster_id;
        const source = map.getSource('places') as maplibregl.GeoJSONSource;
        if (clusterId == null) return;
        const zoom = await source.getClusterExpansionZoom(clusterId);
        const coordinates = (feature.geometry as GeoJSON.Point).coordinates as [number, number];
        map.easeTo({ center: coordinates, zoom, duration: reduceMotion ? 0 : 450 });
      });

      map.on('click', 'place-points', (event) => {
        const feature = event.features?.[0];
        const id = Number(feature?.properties?.id);
        const place = allPlaces.find((item) => item._id === id);
        if (!place) return;
        selectListItem(id, true);
        showPopup(place);
      });

      ['place-clusters', 'place-points'].forEach((layer) => {
        map.on('mouseenter', layer, () => {
          map.getCanvas().style.cursor = 'pointer';
        });
        map.on('mouseleave', layer, () => {
          map.getCanvas().style.cursor = '';
        });
      });
    });

    map.on('error', (event) => {
      if (event.error && errorEl) errorEl.hidden = false;
    });

    async function loadPlaces() {
      if (!dataUrl) return;
      try {
        const response = await fetch(dataUrl);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const payload = await response.json();
        const records = (payload.records ?? payload) as PlaceRecord[];
        const seen = new Set<string>();
        allPlaces = records
          .filter(
            (place) =>
              Number.isFinite(place.latitude) && Number.isFinite(place.longitude),
          )
          .filter((place) => {
            const key = [place.city, place.country, place.show, place.season, place.episode].join('|');
            if (seen.has(key)) return false;
            seen.add(key);
            return true;
          })
          .map((place, index) => ({ ...place, _id: index }));
        visiblePlaces = allPlaces;
        renderList(visiblePlaces);
        updateMapSource(visiblePlaces);
      } catch (error) {
        console.error('Place data failed to load.', error);
        if (errorEl) errorEl.hidden = false;
      }
    }

    searchEl?.addEventListener('input', applyTextFilter);

    searchAreaButton?.addEventListener('click', () => {
      const bounds = map.getBounds();
      const query = searchEl?.value.trim() ?? '';
      visiblePlaces = allPlaces.filter(
        (place) =>
          textMatches(place, query) && bounds.contains([place.longitude, place.latitude]),
      );
      activeId = null;
      renderList(visiblePlaces);
      updateMapSource(visiblePlaces);
    });

    resetButton?.addEventListener('click', () => {
      if (searchEl) searchEl.value = '';
      visiblePlaces = allPlaces;
      activeId = null;
      renderList(visiblePlaces);
      updateMapSource(visiblePlaces);
      map.flyTo({ center: [10, 18], zoom: 1.35, duration: reduceMotion ? 0 : 650 });
    });

    panelToggle?.addEventListener('click', () => {
      setPanelCollapsed(!panel?.classList.contains('is-collapsed'));
    });

    loadPlaces();
  </script>
</BaseLayout>
