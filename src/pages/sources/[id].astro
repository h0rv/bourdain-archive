---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  formatDate,
  formatType,
  sourceGroupFor,
  sourceGroupLabels,
  sourceTimelineDate,
} from '../../lib/content';
import '../../styles/catalog.css';

export async function getStaticPaths() {
  const sources = await getCollection('sources');
  return sources.map((entry) => ({ params: { id: entry.data.id }, props: { entry } }));
}

const { entry } = Astro.props;
const data = entry.data;
const timeline = sourceTimelineDate(data);
const group = sourceGroupFor(data);
---

<BaseLayout title={data.title} description={data.notes ?? data.title}>
  <article class="catalog-page">
    <header class="catalog-intro">
      <h1 class="page-title">{data.title}</h1>
      <p class="catalog-source-meta">
        {formatDate(timeline.date, timeline.precision)}, {formatType(data.type)}, {sourceGroupLabels[group] ?? formatType(group)}
      </p>
    </header>

    {data.notes && <p class="entry-deck">{data.notes}</p>}

    <div class="catalog-source-actions">
      <a href={data.url} target="_blank" rel="noopener noreferrer">Open source</a>
      <a href="../">All sources</a>
    </div>
  </article>
</BaseLayout>
