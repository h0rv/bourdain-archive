---
import { getCollection } from 'astro:content';
import linkPreviewCache from '../../../archive/derived/link-previews.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  entryHref,
  entryTitle,
  formatDate,
  formatType,
  previewForEntry,
  sourceTimelineDate,
} from '../../lib/content';
import { withBase } from '../../lib/site';

const works = await getCollection('works');
const literature = await getCollection('literature');
const sources = await getCollection('sources');
const sourceById = new Map(sources.map((entry) => [entry.data.id, entry]));

const authored = works
  .filter((entry) => entry.data.relation_to_bourdain === 'authored')
  .sort((left, right) => (left.data.date ?? '').localeCompare(right.data.date ?? ''));
const books = authored.filter((entry) => ['book', 'comic'].includes(entry.data.type));
const shorterWorks = authored.filter((entry) => !['book', 'comic'].includes(entry.data.type));
const about = literature
  .filter((entry) => entry.data.relation_to_bourdain !== 'authored')
  .sort((left, right) => (right.data.date ?? '').localeCompare(left.data.date ?? ''));

const webWritingGroups = [
  {
    type: 'social-writing',
    title: 'Tumblr, Medium, and Li.st',
    blurb: "Posts from Bourdain's own accounts.",
  },
  {
    type: 'field-note',
    title: 'Parts Unknown field notes',
    blurb: 'Destination notes written during the production of Parts Unknown.',
  },
  {
    type: 'essay',
    title: 'Essays and articles',
    blurb: 'Magazine, newspaper, and web articles by Bourdain.',
  },
];

const previewFor = (entry: any) => {
  const own = previewForEntry(entry, linkPreviewCache.previews);
  if (own.image) return own;
  for (const sourceId of entry.data.sources ?? []) {
    const source = sourceById.get(sourceId);
    if (!source) continue;
    const sourcePreview = previewForEntry(source, linkPreviewCache.previews);
    if (sourcePreview.image) return { ...own, image: sourcePreview.image };
  }
  return own;
};

const recentPrimaryWriting = sources
  .filter((entry) => ['social-writing', 'field-note', 'article', 'essay'].includes(entry.data.type))
  .map((entry) => ({ entry, timeline: sourceTimelineDate(entry.data) }))
  .filter((item) => item.timeline.date)
  .sort((left, right) => (right.timeline.date ?? '').localeCompare(left.timeline.date ?? ''))
  .slice(0, 8);
---

<BaseLayout
  title="Writings"
  description="Books, essays, stories, field notes, web writing, and selected criticism about Anthony Bourdain."
>
  <header class="page-intro">
    <p class="eyebrow">Books and articles</p>
    <h1 class="page-title">Writings</h1>
    <p class="lede">
      Books and articles by Bourdain appear first. Profiles, criticism, biography, and remembrance
      appear in a separate section below.
    </p>
  </header>

  <section class="home-section" aria-labelledby="books-heading">
    <header class="section-header">
      <div>
        <p class="eyebrow">By Bourdain</p>
        <h2 id="books-heading">Books and comics</h2>
      </div>
    </header>
    <ol class="shelf-grid shelf-grid-books">
      {books.map((entry, index) => {
        const preview = previewFor(entry);
        return (
          <li class="shelf-card">
            <a href={entryHref('works', entry.data.id)}>
              <span class="shelf-card-media is-portrait">
                {preview.image ? (
                  <img
                    src={preview.image}
                    alt=""
                    loading={index < 2 ? 'eager' : 'lazy'}
                    decoding="async"
                    width="400"
                    height="600"
                  />
                ) : (
                  <span class="shelf-card-fallback">{formatType(entry.data.type)}</span>
                )}
              </span>
              <span class="shelf-card-title">{entryTitle(entry)}</span>
              <span class="shelf-card-meta">
                {formatDate(entry.data.date, entry.data.date_precision)}, {formatType(entry.data.type)}
              </span>
            </a>
          </li>
        );
      })}
    </ol>
  </section>

  {shorterWorks.length > 0 && (
    <section class="home-section" aria-labelledby="shorter-heading">
      <header class="section-header">
        <div>
          <p class="eyebrow">By Bourdain</p>
          <h2 id="shorter-heading">Essays and stories</h2>
        </div>
      </header>
      <ol class="editorial-list compact-editorial-list">
        {shorterWorks.map((entry) => {
          const preview = previewFor(entry);
          return (
            <li>
              <a class="editorial-list-media" href={entryHref('works', entry.data.id)}>
                {preview.image ? (
                  <img src={preview.image} alt="" loading="lazy" decoding="async" width="320" height="200" />
                ) : (
                  <span>{formatType(entry.data.type)}</span>
                )}
              </a>
              <div>
                <p class="eyebrow">{formatDate(entry.data.date, entry.data.date_precision)}</p>
                <h3><a href={entryHref('works', entry.data.id)}>{entryTitle(entry)}</a></h3>
                {entry.data.summary && <p>{entry.data.summary}</p>}
              </div>
            </li>
          );
        })}
      </ol>
    </section>
  )}

  <section class="home-section" aria-labelledby="web-heading">
    <header class="section-header">
      <div>
        <p class="eyebrow">By Bourdain</p>
        <h2 id="web-heading">Web writing</h2>
      </div>
      <a href={withBase('/sources/')}>Browse all links</a>
    </header>
    <div class="writing-groups">
      {webWritingGroups.map((group) => (
        <article>
          <h3>{group.title}</h3>
          <p>{group.blurb}</p>
        </article>
      ))}
    </div>
    {recentPrimaryWriting.length > 0 && (
      <ol class="source-strip" aria-label="Recent dated primary writing">
        {recentPrimaryWriting.map(({ entry, timeline }) => (
          <li>
            <a href={entryHref('sources', entry.data.id)}>{entry.data.title}</a>
            <span>{formatDate(timeline.date, timeline.precision)}</span>
          </li>
        ))}
      </ol>
    )}
  </section>

  <section class="home-section" id="about" aria-labelledby="about-heading">
    <header class="section-header">
      <div>
        <p class="eyebrow">About Bourdain</p>
        <h2 id="about-heading">Profiles, criticism, and remembrance</h2>
      </div>
    </header>
    <ol class="editorial-list">
      {about.map((entry) => {
        const preview = previewFor(entry);
        return (
          <li>
            <a class="editorial-list-media" href={entryHref('literature', entry.data.id)}>
              {preview.image ? (
                <img src={preview.image} alt="" loading="lazy" decoding="async" width="320" height="200" />
              ) : (
                <span>{entry.data.publication}</span>
              )}
            </a>
            <div>
              <p class="eyebrow">
                {entry.data.publication}, {formatDate(entry.data.date, entry.data.date_precision)}, {formatType(entry.data.type)}
              </p>
              <h3><a href={entryHref('literature', entry.data.id)}>{entryTitle(entry)}</a></h3>
              {entry.data.summary && <p>{entry.data.summary}</p>}
            </div>
          </li>
        );
      })}
    </ol>
  </section>
</BaseLayout>
