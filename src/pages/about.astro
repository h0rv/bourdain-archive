---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="About the Bourdain Archive and how to send a correction."
>
  <header class="page-intro about-intro">
    <h1 class="page-title">About</h1>
    <p class="lede">
      The Bourdain Archive is an independent guide to Anthony Bourdain's books, articles,
      television, films, interviews, and travels.
    </p>
  </header>

  <div class="prose-grid">
    <section>
      <h2>What is included</h2>
      <p>
        Bourdain's work comes first. The site also includes substantial appearances and published
        reporting and criticism about him.
      </p>
    </section>
    <section>
      <h2>Copyright</h2>
      <p>
        Covers and posters identify each work. Links lead to the original publishers,
        broadcasters, libraries, and publications. The site is not affiliated with Bourdain's
        estate.
      </p>
    </section>
    <section>
      <h2>Corrections</h2>
      <p>
        If a title, date, episode order, link, or image is wrong, send the page and a source that
        confirms the correction.
      </p>
    </section>
  </div>

  <section class="contribute-band">
    <h2>Send a correction</h2>
    <p>
      <a class="primary-action" href="https://github.com/h0rv/bourdain-archive">Open GitHub</a>
    </p>
  </section>
</BaseLayout>
