---
import '../styles/global.css';
import { withBase } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const siteName = 'Bourdain Archive';
const {
  title = siteName,
  description = 'A sourced index of Anthony Bourdain’s writing, television, films, interviews, travels, and cultural legacy.',
  image,
  noindex = false,
} = Astro.props;
const pageTitle = title === siteName ? siteName : `${title} · ${siteName}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const socialImage = new URL(
  image ?? withBase('/images/cook-free-or-die.png'),
  Astro.site ?? Astro.url.origin,
).href;
const currentPath = Astro.url.pathname;
const navItems = [
  { href: withBase('/archive/'), label: 'Archive' },
  { href: withBase('/writings/'), label: 'Writings' },
  { href: withBase('/tv/'), label: 'Television' },
  { href: withBase('/screen/'), label: 'Screen + audio' },
  { href: withBase('/places/'), label: 'Places' },
  { href: withBase('/about/'), label: 'About' },
];
const isCurrent = (href: string) =>
  href === withBase('/') ? currentPath === href : currentPath.startsWith(href);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  description,
  url: new URL(withBase('/'), Astro.site ?? Astro.url.origin).href,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#efe7d8" />
    <meta name="color-scheme" content="light" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="icon" href={withBase('/favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header>
      <nav class="top-bar" aria-label="Primary">
        <a href={withBase('/')} class="top-bar-brand" aria-label="Bourdain Archive home">
          <img src={withBase('/images/cook-free-or-die.png')} alt="" width="46" height="65" loading="eager" decoding="async" />
          <span>
            <strong>Bourdain Archive</strong>
            <small>Cook free or die</small>
          </span>
        </a>
        <span class="top-bar-spacer" aria-hidden="true"></span>
        <ul class="top-bar-links" role="list">
          {navItems.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main-content" class="site-main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        A sourced index—not a content mirror. Built for scholarship, discovery, and the long web.
      </p>
      <nav aria-label="Footer">
        <a href={withBase('/sources/')}>Sources</a>
        <a href="https://github.com/h0rv/bourdain-archive">Contribute on GitHub</a>
      </nav>
    </footer>
  </body>
</html>
