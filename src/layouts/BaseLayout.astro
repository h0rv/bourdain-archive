---
import '../styles/global.css';
import { withBase } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const siteName = 'Bourdain Archive';
const {
  title = siteName,
  description = "A guide to Anthony Bourdain's writing, television, films, interviews, and travels.",
  image,
  noindex = false,
} = Astro.props;
const pageTitle = title === siteName ? siteName : `${title} | ${siteName}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const socialImage = new URL(
  image ?? withBase('/images/cook-free-or-die.png'),
  Astro.site ?? Astro.url.origin,
).href;
const currentPath = Astro.url.pathname;
const homeHref = withBase('/');
const navItems = [
  { href: `${homeHref}#writing`, label: 'Writing' },
  { href: `${homeHref}#television`, label: 'Television' },
  { href: `${homeHref}#film`, label: 'Film' },
  { href: `${homeHref}#interviews`, label: 'Interviews' },
  { href: withBase('/map/'), label: 'Places' },
  { href: withBase('/about/'), label: 'About' },
  { href: withBase('/archive/'), label: 'Search', utility: true },
];
const isCurrent = (href: string) => {
  if (href.includes('#')) return false;
  if (href === withBase('/map/')) {
    return currentPath.startsWith(withBase('/map/')) || currentPath.startsWith(withBase('/places/'));
  }
  return currentPath.startsWith(href);
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  description,
  url: new URL(withBase('/'), Astro.site ?? Astro.url.origin).href,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#efe7d8" />
    <meta name="color-scheme" content="light" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" href={withBase('/favicon-light.png')} type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header>
      <nav class="top-bar" aria-label="Primary">
        <a href={withBase('/')} class="top-bar-brand" aria-label="Bourdain Archive home">
          <img src={withBase('/images/cook-free-or-die.png')} alt="" width="46" height="65" loading="eager" decoding="async" />
          <strong>Bourdain Archive</strong>
        </a>
        <span class="top-bar-spacer" aria-hidden="true"></span>
        <ul class="top-bar-links" role="list">
          {navItems.map((item) => (
            <li>
              <a
                class:list={{ 'top-bar-search': item.utility }}
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                aria-label={item.utility ? 'Search the archive' : undefined}
              >
                {item.utility && (
                  <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
                    <circle cx="10.5" cy="10.5" r="6.5"></circle>
                    <path d="m15.5 15.5 4.5 4.5"></path>
                  </svg>
                )}
                <span class:list={{ 'top-bar-search-label': item.utility }}>{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main-content" class="site-main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <a href="https://github.com/h0rv/bourdain-archive">Corrections and additions on GitHub</a>
    </footer>
  </body>
</html>
