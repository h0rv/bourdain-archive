{
  "name": "bourdain-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "archive": "node scripts/archive-sources.mjs",
    "archive:links": "node scripts/register-web-archives.mjs",
    "preview:links": "node scripts/cache-link-previews.mjs",
    "audit:links": "node scripts/audit-links.mjs",
    "audit:images": "node scripts/audit-images.mjs",
    "audit:generated": "node scripts/audit-generated.mjs",
    "check:duplicates": "node scripts/check-duplicates.mjs",
    "import:series": "node scripts/import-series-episodes.mjs",
    "import:literature": "node scripts/import-literature.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "fmt": "oxfmt src",
    "fmt:check": "oxfmt --check src",
    "review": "node scripts/review-pages.mjs",
    "review:uv": "uvx --from playwright python -m playwright --help || node scripts/review-pages.mjs",
    "test": "npm run check && npm run lint && npm run fmt:check && npm run validate:data && npm run audit:images && npm run build && npm run audit:generated && npm run check:duplicates"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "astro": "^6.1.9",
    "maplibre-gl": "^6.6.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1"
  }
}
